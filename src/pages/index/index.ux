<template>
  <div class="home">
    <div class="homeMark"><image class="homeIcon" src="/common/icon.png"></image></div>
    <text class="title">Chess</text>
    <text class="subtitle">单机双人 · Xiaomi Band 9</text>
    <text class="primary" @click="startGame">{{hasActiveGame?'继续对局':'开始游戏'}}</text>
    <text class="secondary" @click="openSettings">下棋设置</text>
    <text class="secondary" @click="openAbout">关于</text>
    <text class="secondary" @click="exitApp">退出应用</text>
  </div>
</template>
<style>
.home { width:192dp; height:490dp; background-color:#000000; flex-direction:column; align-items:center; padding-top:56dp; }
.homeMark { width:72dp; height:72dp; border-radius:36dp; background-color:#2D3030; justify-content:center; align-items:center; margin-bottom:18dp; }
.homeIcon { width:56dp; height:56dp; object-fit:contain; }
.title { color:#FFFFFF; font-size:24dp; font-weight:bold; line-height:34dp; }
.subtitle { color:rgba(255,255,255,0.55); font-size:13dp; line-height:24dp; margin-bottom:30dp; }
.primary,.secondary { width:154dp; height:44dp; border-radius:22dp; text-align:center; line-height:44dp; font-size:18dp; font-weight:bold; margin-bottom:10dp; }
.primary { background-color:#0D6EFF; color:#FFFFFF; }
.secondary { background-color:#252828; color:#FFFFFF; }
</style>
<script>
import router from '@system.router';
import app from '@system.app';
import storage from '@system.storage';
export default { data:{hasActiveGame:false}, onInit(){this.checkActiveGame();}, onShow(){this.checkActiveGame();}, checkActiveGame(){storage.get({key:'CHESS_ACTIVE_GAME',success:(r)=>{try{const raw=r&&r.data!==undefined?r.data:r;const v=typeof raw==='string'?JSON.parse(raw):raw;this.hasActiveGame=!!(v&&v.board&&v.board.length===64&&!v.gameOver);}catch(e){this.hasActiveGame=false;}},fail:()=>{this.hasActiveGame=false;}});}, startGame(){router.push(this.hasActiveGame?{uri:'/pages/game',params:{resume:'true'}}:{uri:'/pages/setup'});}, openSettings(){router.push({uri:'/pages/settings'});}, openAbout(){router.push({uri:'/pages/about'});}, exitApp(){app.terminate({});} }
</script>
