<template>
  <div class="settingsPage">
    <div class="header"><text class="back" @click="back">‹</text><text class="headerTitle">下棋设置</text></div>
    <div class="setting" @click="toggleAuto"><text class="settingName">选中后自动居中</text><text class="settingValue">{{autoCenter?'开启':'关闭'}}</text></div>
    <div class="setting" @click="cycleBoard"><text class="settingName">棋盘大小</text><text class="settingValue">{{boardSize}}</text></div>
    <text class="footer" @click="back">完成</text>
  </div>
</template>
<style>
.settingsPage { width:192dp; height:490dp; background-color:#000000; padding:18dp 12dp; flex-direction:column; }
.header { width:168dp; height:48dp; flex-direction:row; align-items:center; margin-bottom:12dp; }
.back { color:#FFFFFF; font-size:30dp; width:32dp; text-align:center; }
.headerTitle { color:#FFFFFF; font-size:22dp; font-weight:bold; }
.setting { width:168dp; min-height:54dp; border-radius:18dp; background-color:#252828; margin-bottom:8dp; padding:0 14dp; flex-direction:row; align-items:center; justify-content:space-between; }
.settingName { color:#FFFFFF; font-size:17dp; lines:1; }
.settingValue { color:#4EA1FF; font-size:15dp; }
.footer { width:168dp; height:44dp; border-radius:22dp; background-color:#0D6EFF; color:#FFFFFF; text-align:center; line-height:44dp; font-size:18dp; margin-top:12dp; }
</style>
<script>
import router from '@system.router';
import storage from '@system.storage';
export default {
  data:{autoCenter:true,boardSize:'标准'},
  onInit(){this.load();},
  onShow(){this.load();},
  load(){storage.get({key:'CHESS_SETTINGS',success:(data)=>{try{const raw=data&&data.data!==undefined?data.data:data;if(raw===undefined||raw===null||raw==='')return;const v=typeof raw==='string'?JSON.parse(raw):raw;this.autoCenter=v.autoCenter!==false;this.boardSize=v.boardSize||'标准';}catch(e){}},fail:()=>{}});},
  save(){storage.set({key:'CHESS_SETTINGS',value:JSON.stringify({autoCenter:this.autoCenter,boardSize:this.boardSize})});},
  back(){this.save();router.back();},
  toggleAuto(){this.autoCenter=!this.autoCenter;this.save();},
  cycleBoard(){this.boardSize=this.boardSize==='标准'?'放大':(this.boardSize==='放大'?'紧凑':'标准');this.save();}
}
</script>
