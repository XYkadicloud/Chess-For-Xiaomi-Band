<template>
  <div class="page">
    <div class="header"><text class="back" @click="back">‹</text><text class="headerTitle">历史棋局</text></div>
    <list class="list" if="{{items.length}}">
      <list-item for="{{items}}" type="game" class="item" @click="openItem($item)">
        <div class="itemLeft">
          <text class="itemResult">{{$item.resultLabel}}</text>
          <text class="itemDate">{{$item.dateLabel}}</text>
        </div>
        <div class="itemRight">
          <text class="itemMoves">{{$item.moveCount}}步</text>
          <text class="itemTC">{{$item.timeControl}}</text>
        </div>
      </list-item>
    </list>
    <div class="emptyWrap" if="{{!items.length}}">
      <image class="emptyImg" src="/common/images/empty.png"></image>
      <text class="emptyText">暂无历史棋局</text>
      <text class="emptySub">下满8步后自动保存</text>
      <text class="emptySub">或手动选择"暂停保存"</text>
    </div>
    <text class="clearBtn" if="{{items.length}}" @click="clearAll">清空记录</text>
  </div>
</template>
<style>
.page { width:192dp; height:490dp; background-color:#000000; flex-direction:column; padding:18dp 12dp; overflow:hidden; }
.header { width:168dp; height:42dp; flex-direction:row; align-items:center; margin-bottom:12dp; }
.back { width:32dp; color:#FFFFFF; font-size:30dp; text-align:center; }
.headerTitle { color:#FFFFFF; font-size:22dp; font-weight:bold; }
.list { width:168dp; height:380dp; }
.item { width:168dp; min-height:64dp; border-radius:18dp; background-color:#252828; margin-bottom:8dp; padding:10dp 14dp; flex-direction:row; align-items:center; justify-content:space-between; }
.itemLeft { flex-direction:column; flex:1; justify-content:space-around; }
.itemResult { color:#FFFFFF; font-size:17dp; font-weight:bold; lines:1; text-overflow:ellipsis; }
.itemDate { color:rgba(255,255,255,0.55); font-size:13dp; lines:1; }
.itemRight { flex-direction:column; align-items:flex-end; justify-content:space-around; }
.itemMoves { color:#4EA1FF; font-size:15dp; font-weight:bold; }
.itemTC { color:rgba(255,255,255,0.5); font-size:12dp; }
.emptyWrap { width:168dp; height:380dp; flex-direction:column; justify-content:center; align-items:center; }
.emptyImg { width:72dp; height:72dp; margin-bottom:16dp; object-fit:contain; }
.emptyText { color:#FFFFFF; font-size:20dp; font-weight:bold; margin-bottom:6dp; }
.emptySub { color:rgba(255,255,255,0.5); font-size:13dp; margin-bottom:4dp; }
.clearBtn { width:168dp; height:40dp; border-radius:20dp; background-color:#8D2B2B; color:#FFFFFF; font-size:16dp; text-align:center; line-height:40dp; margin-top:10dp; font-weight:bold; }
</style>
<script>
import router from '@system.router';
import storage from '@system.storage';
const KEY = 'CHESS_GAME_HISTORY';
const ACTIVE_KEY = 'CHESS_ACTIVE_GAME';
export default {
  data: { items: [] },
  onShow() { this.load(); },
  load() {
    const that = this;
    storage.get({
      key: KEY,
      success(res) {
        try {
          const raw = (res && (res.data !== undefined && res.data !== null)) ? res.data : res;
          if (!raw) { that.items = []; return; }
          const arr = (typeof raw === 'string') ? JSON.parse(raw) : raw;
          that.items = Array.isArray(arr) ? arr : [];
        } catch (e) { that.items = []; }
      },
      fail() { that.items = []; }
    });
  },
  back() { router.back(); },
  openItem(item) {
    if (!item || !item.id) return;
    router.push({ uri: '/pages/historyDetail', params: { id: String(item.id) } });
  },
  clearAll() {
    const that = this;
    storage.set({
      key: KEY,
      value: '[]',
      success() { that.items = []; },
      fail() { that.load(); }
    });
    storage.delete({ key: ACTIVE_KEY, fail() {} });
  }
}
</script>
