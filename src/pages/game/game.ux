<template>
  <div class="page" @swipe="blockSwipe">
    <div class="topbar">
      <text class="turn">{{ statusText }}</text>
      <text class="menuButton" @click="toggleMenu">☰</text>
    </div>
    <div class="clocks"><text class="clock" style="color:{{turn==='white'?'#4EA1FF':'#FFFFFF'}};">白 {{whiteClock}}</text><text class="clock" style="color:{{turn==='black'?'#4EA1FF':'#FFFFFF'}};">黑 {{blackClock}}</text></div>

    <div class="boardViewport" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd">
      <div class="board" style="width:{{boardSize}}dp;height:{{boardSize}}dp;left:{{boardLeft}}dp;top:{{boardTop}}dp;">
        <div class="square" for="{{squares}}"
             style="width:{{squareSize}}dp;height:{{squareSize}}dp;left:{{$item.x}}dp;top:{{$item.y}}dp;background-color:{{$item.color}};border:{{$item.border}};"
             >
          <image class="pieceImage" if="{{$item.pieceSrc}}" src="{{$item.pieceSrc}}"></image>
          <div class="legalDot" if="{{$item.legal}}"></div>
        </div>
      </div>
    </div>

    <div class="hint"><text class="hintText">{{hintText}}</text></div>
    <div class="bottom"><text class="action" @click="undoMove">悔棋</text><text class="action" @click="openMenu">菜单</text></div>

    <div class="overlay" if="{{menuVisible}}">
      <div class="menuCard">
        <text class="menuTitle">棋局菜单</text>
        <text class="menuItem" @click="pauseAndSave">暂停保存</text>
        <text class="menuItem" @click="newGame">新建棋局</text>
        <text class="menuItem" @click="undoMove">悔棋</text>
        <text class="menuItem" @click="confirmResign">认输</text>
        <text class="menuItem" @click="offerDraw">和棋</text>
        <text class="menuItem" @click="showPGN">查看棋谱</text>
        <text class="menuItem" @click="openSettings">设置</text>
        <text class="menuItem exitItem" @click="exitGame">退出对局</text>
        <text class="menuItem" @click="closeMenu">返回棋局</text>
      </div>
    </div>

    <div class="overlay" if="{{settingsVisible}}">
      <div class="menuCard resultCard">
        <text class="menuTitle">下棋设置</text>
        <text class="menuItem" @click="toggleHints">走法提示：{{showHints ? '开' : '关'}}</text>
        <text class="menuItem" @click="toggleAutoCenter">自动居中：{{autoCenter ? '开' : '关'}}</text>
        <text class="menuItem" @click="toggleConfirm">认输确认：{{confirmBeforeResign ? '开' : '关'}}</text>
        <text class="menuItem" @click="cycleBoardSize">棋盘大小：{{boardSizeLabel}}</text>
        <text class="menuItem" @click="closeSettings">完成</text>
      </div>
    </div>

    <div class="overlay" if="{{resultVisible}}">
      <div class="menuCard">
        <text class="menuTitle">{{resultTitle}}</text>
        <text class="menuItem" @click="saveAndNew">保存并再来一局</text>
        <text class="menuItem" @click="showPGNFromResult">查看棋谱</text>
        <text class="menuItem exitItem" @click="exitFromResult">退出对局</text>
        <text class="menuItem" @click="closeResult">查看棋局</text>
      </div>
    </div>

    <div class="overlay" if="{{promotionVisible}}">
      <div class="menuCard promoCard">
        <text class="menuTitle">选择升变</text>
        <div class="promoRow">
          <text class="promoItem" @click="pickPromotion('Q')">♛ 后</text>
          <text class="promoItem" @click="pickPromotion('R')">♜ 车</text>
        </div>
        <div class="promoRow">
          <text class="promoItem" @click="pickPromotion('B')">♝ 象</text>
          <text class="promoItem" @click="pickPromotion('N')">♞ 马</text>
        </div>
      </div>
    </div>

    <div class="overlay" if="{{pgnVisible}}">
      <div class="menuCard pgnCard">
        <text class="menuTitle">棋谱记录</text>
        <text class="pgnMeta">步数：{{sanHistory.length}} · {{timeControlText}}</text>
        <list class="pgnScroll" if="{{pgnRows.length}}">
          <list-item for="{{pgnRows}}" type="pgnrow" class="pgnRow"><text class="pgnLine">{{$item}}</text></list-item>
        </list>
        <div class="pgnEmpty" if="{{!pgnRows.length}}"><text class="pgnTextEmpty">（暂无棋步）</text></div>
        <text class="menuItem" @click="savePGNOnly">保存到历史</text>
        <text class="menuItem" @click="closePGN">返回</text>
      </div>
    </div>
  </div>
</template>

<style>
.page { width:192dp; height:490dp; background-color:#000000; flex-direction:column; overflow:hidden; }
.topbar { width:192dp; height:48dp; padding:8dp 12dp 0dp 12dp; flex-direction:row; justify-content:space-between; align-items:center; }
.turn { color:#FFFFFF; font-size:20dp; font-weight:bold; width:170dp; lines:1; text-overflow:ellipsis; }
.menuButton { color:#FFFFFF; font-size:21dp; width:24dp; text-align:center; }
.clocks { width:192dp; height:26dp; flex-direction:row; justify-content:space-around; align-items:center; }
.clock { font-size:16dp; font-weight:bold; width:82dp; text-align:center; }
.boardViewport { width:192dp; height:280dp; position:relative; overflow:hidden; background-color:#050505; }
.board { position:absolute; }
.square { position:absolute; justify-content:center; align-items:center; }
.pieceImage { width:78%; height:78%; object-fit:contain; z-index:3; }
.square { border-style:solid; border-width:0dp; }
.square .selected { border-width:3dp; border-color:#0D6EFF; }
.legalDot { width:10dp; height:10dp; border-radius:5dp; background-color:#0D6EFF; position:absolute; z-index:4; align-self:center; justify-content:center; }
.hint { width:192dp; height:46dp; justify-content:center; align-items:center; }
.hintText { color:rgba(255,255,255,0.7); font-size:16dp; text-align:center; }
.bottom { width:192dp; height:58dp; justify-content:space-around; align-items:center; }
.action { color:#FFFFFF; background-color:#262626; border-radius:20dp; padding:8dp 18dp; font-size:16dp; font-weight:bold; }
.overlay { position:absolute; left:0dp; top:0dp; width:192dp; height:490dp; background-color:rgba(0,0,0,0.92); justify-content:center; align-items:center; z-index:20; }
.menuCard { width:168dp; padding:14dp 10dp; background-color:#262626; border-radius:22dp; align-items:center; flex-direction:column; max-height:470dp; }
.resultCard { padding-top:20dp; padding-bottom:20dp; }
.promoCard { width:168dp; }
.promoRow { width:150dp; flex-direction:row; justify-content:space-around; margin-top:8dp; }
.promoItem { width:68dp; height:46dp; border-radius:14dp; background-color:#3A3A3A; color:#FFFFFF; font-size:18dp; font-weight:bold; text-align:center; line-height:46dp; }
.pgnCard { height:450dp; padding:12dp 10dp; }
.menuTitle { color:#FFFFFF; font-size:22dp; font-weight:bold; margin-bottom:8dp; }
.pgnMeta { color:rgba(255,255,255,0.55); font-size:13dp; margin-bottom:8dp; }
.pgnScroll { width:152dp; height:248dp; background-color:#1A1A1A; border-radius:14dp; }
.pgnRow { width:152dp; padding:3dp 10dp; flex-direction:column; min-height:24dp; }
.pgnLine { color:#FFFFFF; font-size:14dp; line-height:20dp; width:100%; lines:1; text-overflow:ellipsis; }
.pgnEmpty { width:152dp; height:50dp; justify-content:center; align-items:center; }
.pgnTextEmpty { color:rgba(255,255,255,0.5); font-size:14dp; }
.menuItem { width:142dp; height:36dp; margin-top:5dp; border-radius:19dp; background-color:#3A3A3A; color:#FFFFFF; font-size:15dp; text-align:center; line-height:36dp; }
.exitItem { background-color:#8D2B2B; }
.coord { color:rgba(255,255,255,0.25); font-size:10dp; }
</style>

<script>
import storage from '@system.storage';
import router from '@system.router';
const WHITE = 'white';
const BLACK = 'black';
const GLYPHS = { wK:'K', wQ:'Q', wR:'R', wB:'B', wN:'N', wP:'P', bK:'k', bQ:'q', bR:'r', bB:'b', bN:'n', bP:'p' };
const FILES = 'abcdefgh';
const RANKS = '87654321';
const SETTINGS_KEY = 'CHESS_SETTINGS';
const HISTORY_KEY = 'CHESS_GAME_HISTORY';
const ACTIVE_KEY = 'CHESS_ACTIVE_GAME';
const MIN_MOVES = 8;
const MAX_HISTORY = 50;
const MAX_UNDO = 60;
const CLEAR_TASK_PARAM = '___PARAM_LAUNCH_FLAG___';

const PIECE_MASK = { K:1, Q:2, R:4, B:8, N:16, P:32 };
const COLOR_SHIFT = 6;

export default {
  private: {
    board: [],
    squares: [], history: [], sanHistory: [],
    turn: WHITE, selected: -1, legalMoves: [], lastMove: [],
    squareSize: 30, boardSize: 240, boardLeft: -22, boardTop: 20,
    castling: {wK:true,wQ:true,bK:true,bQ:true}, enPassantTarget: -1,
    legalCache: null,
    menuVisible: false, settingsVisible: false, resultVisible: false,
    pgnVisible: false, gameOver: false, paused: false,
    gameId: '', savedToHistory: false, saveInFlight: false,
    showHints: true, autoCenter: true, confirmBeforeResign: true,
    whiteSeconds:600, blackSeconds:600, whiteClock:'10:00', blackClock:'10:00',
    timerId:null, lastTick:0, halfmoveClock:0, positionCounts:{}, touchTimerId:null,
    resultTitle: '', hintText: '点击棋子开始走子',
    touchX: 0, touchY: 0, pendingTouchX: 0, pendingTouchY: 0, dragging: false, touchMoved: false, touchQueued: false,
    initialMinutes: 10, unlimited: false, finalResult: '',
    promotionVisible: false, pendingPromotion: null,
    initStarted: false
  },
  protected: { minutes: '10', resume: '', unlimited: 'false', boardSize: '30' },
  computed: {
    statusText() { return (this.resultVisible || this.gameOver) ? '对局结束' : (this.turn === WHITE ? '白方回合' : '黑方回合'); },
    boardSizeLabel() { return this.squareSize===44?'放大':(this.squareSize===24?'紧凑':'标准'); },
    timeControlText() { return this.unlimited ? '∞' : ((this.initialMinutes||10) + '+0'); },
    pgnRows() { return this.pgnRowList(); }
  },
  pgnRowList() {
    const arr = this.sanHistory || [];
    if (!arr.length) return [];
    const rows = [];
    for (let i = 0; i < arr.length; i += 2) {
      const n = Math.floor(i / 2) + 1;
      const w = arr[i] || '';
      const b = arr[i + 1] || '';
      rows.push(n + '. ' + w + (b ? '  ' + b : ''));
    }
    if (this.finalResult) rows.push(this.finalResult);
    return rows;
  },
  sqAlg(i) { return FILES[i%8] + RANKS[(i/8)|0]; },
  onInit() {
    this.unlimited = String(this.unlimited) === 'true';
    const routeMinutes = parseInt(String(this.minutes), 10);
    this.initialMinutes = isNaN(routeMinutes) || routeMinutes < 0 ? 10 : routeMinutes;
    this.legalCache = {};
    this.gameId = 'g_' + Date.now().toString(36) + '_' + (Math.random()*1000|0).toString(36);
    this.initStarted = true;
    this.showHints = true;
    this.autoCenter = true;
    this.confirmBeforeResign = true;
    this.applyBoardSize(this.boardSize || 30);
    this.newPosition();
  },
  onShow(){ this.lastTick = Date.now(); if (!this.gameOver && !this.resultVisible && !this.paused) this.startClock(); },
  applyBoardSize(v) {
    const n = parseInt(v, 10);
    this.squareSize = n === 44 ? 44 : (n === 24 ? 24 : 30);
    this.boardSize = this.squareSize * 8;
    this.boardLeft = Math.max(this.maxBoardLeft(), Math.min(0, this.boardLeft));
    this.boardTop = Math.max(this.maxBoardTop(), Math.min(0, this.boardTop));
  },
  onHide(){ this.stopClock(); },
  onDestroy() {
    this.stopClock();
    if (this.touchTimerId) { clearTimeout(this.touchTimerId); this.touchTimerId = null; }
    try {
      if (typeof global !== 'undefined' && global && typeof global.runGC === 'function') global.runGC();
    } catch (e) {}
  },
  startClock(){ if (this.unlimited || this.timerId || this.gameOver || this.resultVisible || this.paused) return; this.timerId = setInterval(() => this.tickClock(), 1000); },
  stopClock(){ if (this.timerId) { clearInterval(this.timerId); this.timerId = null; } },
  tickClock(){
    if (this.unlimited || this.resultVisible || this.gameOver || this.paused) return;
    const now = Date.now();
    const elapsed = Math.max(0, ((now - this.lastTick)/1000)|0);
    this.lastTick = now;
    if (this.turn === 'white') this.whiteSeconds = Math.max(0, this.whiteSeconds - elapsed);
    else this.blackSeconds = Math.max(0, this.blackSeconds - elapsed);
    this.whiteClock = this.formatClock(this.whiteSeconds);
    this.blackClock = this.formatClock(this.blackSeconds);
    if ((this.turn === 'white' && this.whiteSeconds <= 0) || (this.turn === 'black' && this.blackSeconds <= 0)) this.finishByTimeout();
  },
  finishByTimeout(){
    if (this.resultVisible || this.gameOver) return;
    const loser = this.turn;
    const opp = loser === WHITE ? BLACK : WHITE;
    this.gameOver = true; this.stopClock();
    if (this.opponentHasSufficientMaterial(opp)) {
      this.resultTitle = (loser === WHITE ? '黑方' : '白方') + '胜（超时）';
      this.finalResult = loser === WHITE ? '0-1' : '1-0';
    } else {
      this.resultTitle = '和棋（超时但兵力不足）';
      this.finalResult = '1/2-1/2';
    }
    this.resultVisible = true;
    this.hintText = this.resultTitle;
  },
  formatClock(s){ if (this.unlimited) return '∞'; const mins = (s/60)|0; const secs = s%60; return (mins<10?'0':'')+mins+':'+(secs<10?'0':'')+secs; },
  newPosition() {
    this.gameOver = false; this.savedToHistory = false; this.saveInFlight = false; this.paused = false;
    this.gameId = 'g_' + Date.now().toString(36) + '_' + (Math.random()*1000|0).toString(36);
    this.finalResult = '';
    const b = new Array(64);
    for (let n = 0; n < 64; n++) b[n] = null;
    const back = ['R','N','B','Q','K','B','N','R'];
    for (let i = 0; i < 8; i++) { b[i] = 'b'+back[i]; b[8+i] = 'bP'; b[48+i] = 'wP'; b[56+i] = 'w'+back[i]; }
    this.board = b; this.turn = WHITE; this.selected = -1; this.legalMoves = [];
    this.lastMove = []; this.history = []; this.sanHistory = [];
    this.castling = {wK:true, wQ:true, bK:true, bQ:true};
    this.enPassantTarget = -1; this.halfmoveClock = 0;
    this.positionCounts = {};
    this.positionCounts[this.positionKey(this.board, this.turn, this.enPassantTarget, this.castling)] = 1;
    const startSeconds = this.unlimited ? 0 : (this.initialMinutes || 10) * 60;
    this.whiteSeconds = startSeconds; this.blackSeconds = startSeconds;
    this.whiteClock = this.unlimited ? '∞' : this.formatClock(startSeconds); this.blackClock = this.unlimited ? '∞' : this.formatClock(startSeconds);
    this.lastTick = Date.now();
    this.resultVisible = false; this.pgnVisible = false; this.menuVisible = false;
    this.settingsVisible = false; this.promotionVisible = false; this.pendingPromotion = null;
    this.hintText = '点击棋子开始走子'; this.legalCache = {};
    this.buildSquares();
  },
  buildSquares() {
    const s = new Array(64);
    const sz = this.squareSize, board = this.board, lm = this.lastMove, lm0 = lm[0], lm1 = lm[1];
    const sel = this.selected, hints = this.showHints, legals = this.legalMoves;
    const haveLegals = hints && legals && legals.length;
    for (let i = 0; i < 64; i++) {
      const row = (i/8)|0, col = i % 8;
      const p = board[i];
      let legal = false;
      if (haveLegals) { for (let k = 0; k < legals.length; k++) { if (legals[k] === i) { legal = true; break; } } }
      s[i] = {
        index: i,
        x: col * sz, y: row * sz,
        color: (i === lm0 || i === lm1) ? 'rgba(255,149,0,0.32)' : (((row + col) & 1) ? '#B8B8B8' : '#3A3A3A'),
        border: i === sel ? '3dp solid #0D6EFF' : '0dp solid transparent',
        piece: p ? GLYPHS[p] : '',
        pieceSrc: p ? '/common/pieces/' + p + '.png' : '',
        pieceColor: p && p[0] === 'w' ? '#FFFFFF' : '#111111',
        legal: legal
      };
    }
    this.squares = s;
  },
  tapSquare(i) {
    if (this.resultVisible || this.gameOver || this.pgnVisible || this.settingsVisible || this.menuVisible || this.promotionVisible || this.paused) return;
    const legals = this.legalMoves;
    if (this.selected >= 0 && legals && legals.length) {
      for (let k = 0; k < legals.length; k++) {
        if (legals[k] === i) { this.move(this.selected, i); return; }
      }
    }
    const p = this.board[i];
    if (p && p[0] === this.turn[0]) {
      this.selected = i;
      if (this.showHints) {
        this.legalMoves = this.getMovesFast(i);
      } else this.legalMoves = [];
      this.hintText = '已选择 ' + this.sqAlg(i) + '，点击蓝点落子';
      if (this.autoCenter) this.centerOn(i);
      this.buildSquares();
    } else {
      if (this.selected === -1 && (!legals || legals.length === 0)) return;
      this.selected = -1; this.legalMoves = [];
      this.hintText = '请先选择当前回合的棋子';
      this.buildSquares();
    }
  },
  positionKey(board, turn, ep, castling) {
    let s = '';
    for (let i = 0; i < 64; i++) s += board[i] || '-';
    return s + (turn === WHITE ? 'w' : 'b') + ep +
      (castling.wK?'K':'') + (castling.wQ?'Q':'') + (castling.bK?'k':'') + (castling.bQ?'q':'');
  },
  move(from, to) {
    this.tickClock();
    if (this.resultVisible || this.gameOver || this.paused) return;
    const board = this.board;
    const moving = board[from];
    const captured = board[to];
    const type = moving[1];
    const color = moving[0];
    const needPromotion = (type === 'P' && ((to >>> 3) === 0 || (to >>> 3) === 7));

    if (this.history.length >= MAX_UNDO) this.history.shift();
    const previousPositionKey = this.positionKey(this.board, this.turn, this.enPassantTarget, this.castling);
    this.history.push({
      board: board.slice(),
      turn: this.turn,
      last: this.lastMove.slice(),
      castling: {wK:this.castling.wK,wQ:this.castling.wQ,bK:this.castling.bK,bQ:this.castling.bQ},
      ep: this.enPassantTarget,
      whiteSeconds: this.whiteSeconds, blackSeconds: this.blackSeconds,
      halfmoveClock: this.halfmoveClock,
      positionKey: previousPositionKey,
      positionCount: this.positionCounts[previousPositionKey] || 1,
      san: this.sanHistory.slice(),
      selected: this.selected
    });

    if (needPromotion) {
      this.pendingPromotion = { from: from, to: to, captured: captured, moving: moving, color: color, type: type };
      this.promotionVisible = true;
      this.stopClock();
      return;
    }
    this.commitMove(from, to, captured, null);
  },
  pickPromotion(kind) {
    const pp = this.pendingPromotion;
    this.pendingPromotion = null; this.promotionVisible = false;
    if (!pp) return;
    this.lastTick = Date.now();
    this.startClock();
    this.commitMove(pp.from, pp.to, pp.captured, kind);
  },
  commitMove(from, to, captured, promotionKind) {
    const moving = this.board[from];
    const type = moving[1], color = moving[0];
    const previousEp = this.enPassantTarget;
    const previousLast = this.lastMove;

    const b = this.board.slice();
    let capturedOnMove = !!captured;
    b[to] = moving; b[from] = null;

    if (type === 'P') {
      const dRow = (to >>> 3) - (from >>> 3);
      if (Math.abs(dRow) === 1 && ((to - from) & 7) !== 0 && !captured && previousEp === to) {
        const cap = color === 'w' ? (to + 8) : (to - 8);
        if (b[cap] && b[cap][1] === 'P' && b[cap][0] !== color) { b[cap] = null; capturedOnMove = true; }
      }
    }
    if (type === 'K' && Math.abs(to - from) === 2) {
      const rookFrom = to > from ? (from + 3) : (from - 4);
      const rookTo = to > from ? (from + 1) : (from - 1);
      b[rookTo] = b[rookFrom]; b[rookFrom] = null;
    }
    if (type === 'P' && ((to >>> 3) === 0 || (to >>> 3) === 7)) {
      const pk = promotionKind === 'R' || promotionKind === 'B' || promotionKind === 'N' ? promotionKind : 'Q';
      b[to] = color + pk;
      promotionKind = pk;
    } else promotionKind = null;

    const newCastling = {wK:this.castling.wK, wQ:this.castling.wQ, bK:this.castling.bK, bQ:this.castling.bQ};
    if (type === 'K') { if (color === 'w') { newCastling.wK = false; newCastling.wQ = false; } else { newCastling.bK = false; newCastling.bQ = false; } }
    if (type === 'R') {
      if (from === 63) newCastling.wK = false;
      if (from === 56) newCastling.wQ = false;
      if (from === 7) newCastling.bK = false;
      if (from === 0) newCastling.bQ = false;
    }
    if (from === 63 || to === 63) newCastling.wK = false;
    if (from === 56 || to === 56) newCastling.wQ = false;
    if (from === 7 || to === 7) newCastling.bK = false;
    if (from === 0 || to === 0) newCastling.bQ = false;

    let newEp = -1;
    if (type === 'P' && Math.abs((to >>> 3) - (from >>> 3)) === 2) {
      newEp = color === 'w' ? (from - 8) : (from + 8);
    }

    this.castling = newCastling;
    this.enPassantTarget = newEp;
    this.board = b;
    this.lastMove = [from, to];
    this.halfmoveClock = (type === 'P' || capturedOnMove) ? 0 : this.halfmoveClock + 1;

    const san = this.sanFromMove(from, to, capturedOnMove, promotionKind, previousEp);
    const oppTurn = this.turn === WHITE ? BLACK : WHITE;
    const inCheck = this.isInCheckBoard(b, oppTurn);
    const hasMove = this.hasLegalMoveForBoard(oppTurn, b, newEp, newCastling);
    let finalSan = san;
    if (!hasMove && inCheck) finalSan += '#';
    else if (inCheck) finalSan += '+';
    this.sanHistory.push(finalSan);

    this.selected = -1; this.legalMoves = []; this.legalCache = {};
    this.turn = oppTurn;
    const key = this.positionKey(this.board, this.turn, this.enPassantTarget, this.castling);
    this.positionCounts[key] = (this.positionCounts[key] || 0) + 1;
    this.lastTick = Date.now();
    this.hintText = inCheck ? '将军，请交给' + (this.turn === WHITE ? '白方' : '黑方') : '走子完成，请交给' + (this.turn === WHITE ? '白方' : '黑方');
    this.buildSquares();

    if (!hasMove && inCheck) {
      this.gameOver = true; this.stopClock();
      this.resultTitle = (this.turn === WHITE ? '黑方' : '白方') + '胜（将死）';
      this.finalResult = this.turn === WHITE ? '0-1' : '1-0';
      this.resultVisible = true;
    } else if (!hasMove && !inCheck) {
      this.gameOver = true; this.stopClock();
      this.resultTitle = '和棋（逼和）';
      this.finalResult = '1/2-1/2';
      this.resultVisible = true;
    } else if (this.isInsufficientMaterial(b) || this.halfmoveClock >= 100 || this.positionCounts[key] >= 3) {
      this.gameOver = true; this.stopClock();
      if (this.halfmoveClock >= 100) this.resultTitle = '和棋（五十步）';
      else if (this.positionCounts[key] >= 3) this.resultTitle = '和棋（三次重复）';
      else this.resultTitle = '和棋（兵力不足）';
      this.finalResult = '1/2-1/2';
      this.resultVisible = true;
    }
  },
  sanFromMove(from, to, captured, promotion, oldEp) {
    const board = this.board;
    const p = board[to];
    if (!p) return this.sqAlg(from) + this.sqAlg(to);
    const type = p[1], color = p[0];
    if (type === 'K' && Math.abs(to - from) === 2) return to > from ? 'O-O' : 'O-O-O';
    let san = '';
    if (type !== 'P') {
      san += type;
      const prefix = color + type;
      const matches = [];
      for (let i = 0; i < 64; i++) if (i !== from && board[i] === prefix) matches.push(i);
      if (matches.length) {
        let disambiguateCol = false, disambiguateRow = false, disambiguateAll = false;
        const fromCol = from & 7, fromRow = (from >>> 3);
        for (let n = 0; n < matches.length; n++) {
          const m = matches[n];
          if (!this.canPseudoReachTarget(m, to, board)) continue;
          if (!this.isLegalOnBoard(m, to, color, board, this.enPassantTarget, this.castling)) continue;
          const mc = m & 7, mr = (m >>> 3);
          if (mc === fromCol && mr === fromRow) continue;
          if (mc === fromCol) disambiguateCol = true;
          if (mr === fromRow) disambiguateRow = true;
          disambiguateAll = true;
        }
        if (disambiguateAll) {
          if (!disambiguateCol) san += FILES[fromCol];
          else if (!disambiguateRow) san += RANKS[fromRow];
          else san += FILES[fromCol] + RANKS[fromRow];
        }
      }
    }
    if (captured) {
      if (type === 'P') san += FILES[from & 7];
      san += 'x';
    }
    san += this.sqAlg(to);
    if (promotion) san += '=' + promotion;
    return san;
  },
  canPseudoReachTarget(from, target, board) {
    const p = board[from]; if (!p) return false;
    const type = p[1];
    const fr = (from >>> 3), fc = from & 7, tr = (target >>> 3), tc = target & 7;
    if (type === 'P') return false;
    if (type === 'N') {
      const dr = Math.abs(tr-fr), dc = Math.abs(tc-fc);
      return (dr === 1 && dc === 2) || (dr === 2 && dc === 1);
    }
    if (type === 'K') return Math.max(Math.abs(tr-fr), Math.abs(tc-fc)) <= 1;
    const sameRow = fr === tr, sameCol = fc === tc, sameDiag = (tr-fr) === (tc-fc) || (tr-fr) === -(tc-fc);
    if (type === 'Q' && !(sameRow || sameCol || sameDiag)) return false;
    if (type === 'R' && !(sameRow || sameCol)) return false;
    if (type === 'B' && !sameDiag) return false;
    const dr = tr === fr ? 0 : (tr > fr ? 1 : -1);
    const dc = tc === fc ? 0 : (tc > fc ? 1 : -1);
    let r = fr + dr, c = fc + dc;
    while (r !== tr || c !== tc) {
      if (board[r*8+c]) return false;
      r += dr; c += dc;
    }
    return !board[target] || board[target][0] !== p[0];
  },
  applyBoardMove(board, from, to, ep) {
    const b = board.slice();
    const p = b[from]; if (!p) return b;
    const color = p[0], type = p[1];
    const captured = b[to];
    b[to] = p; b[from] = null;
    if (type === 'P' && !captured && ((to - from) & 7) !== 0 && Math.abs((to>>>3)-(from>>>3)) === 1 && ep === to) {
      const cap = color === 'w' ? (to + 8) : (to - 8);
      if (b[cap] && b[cap][0] !== color && b[cap][1] === 'P') b[cap] = null;
    }
    if (type === 'K' && Math.abs(to - from) === 2) {
      const rf = to > from ? (from + 3) : (from - 4), rt = to > from ? (from + 1) : (from - 1);
      b[rt] = b[rf]; b[rf] = null;
    }
    if (type === 'P' && ((to >>> 3) === 0 || (to >>> 3) === 7)) b[to] = color + 'Q';
    return b;
  },
  isSquareAttacked(board, sq, by) {
    const r = (sq >>> 3), c = sq & 7;
    const pr = by === 'w' ? r + 1 : r - 1;
    if (pr >= 0 && pr < 8) {
      for (const dc of [-1, 1]) {
        const pc = c + dc;
        if (pc >= 0 && pc < 8 && board[pr*8+pc] === by + 'P') return true;
      }
    }
    const nMoves = [[1,2],[2,1],[-1,2],[-2,1],[1,-2],[2,-1],[-1,-2],[-2,-1]];
    for (let k = 0; k < nMoves.length; k++) {
      const rr = r + nMoves[k][0], cc = c + nMoves[k][1];
      if ((rr|cc) >= 0 && rr < 8 && cc < 8 && board[rr*8+cc] === by + 'N') return true;
    }
    for (let dr = -1; dr <= 1; dr++) {
      for (let dc = -1; dc <= 1; dc++) {
        if (!dr && !dc) continue;
        const rr = r + dr, cc = c + dc;
        if (rr >= 0 && rr < 8 && cc >= 0 && cc < 8 && board[rr*8+cc] === by + 'K') return true;
      }
    }
    const rookDirs = [[1,0],[-1,0],[0,1],[0,-1]];
    for (let k = 0; k < rookDirs.length; k++) {
      let rr = r + rookDirs[k][0], cc = c + rookDirs[k][1];
      while (rr >= 0 && rr < 8 && cc >= 0 && cc < 8) {
        const q = board[rr*8+cc];
        if (q) { if (q[0] === by && (q[1] === 'R' || q[1] === 'Q')) return true; break; }
        rr += rookDirs[k][0]; cc += rookDirs[k][1];
      }
    }
    const bishDirs = [[1,1],[1,-1],[-1,1],[-1,-1]];
    for (let k = 0; k < bishDirs.length; k++) {
      let rr = r + bishDirs[k][0], cc = c + bishDirs[k][1];
      while (rr >= 0 && rr < 8 && cc >= 0 && cc < 8) {
        const q = board[rr*8+cc];
        if (q) { if (q[0] === by && (q[1] === 'B' || q[1] === 'Q')) return true; break; }
        rr += bishDirs[k][0]; cc += bishDirs[k][1];
      }
    }
    return false;
  },
  isInCheckBoard(board, color) {
    const king = color + 'K';
    let kingSq = -1;
    for (let i = 0; i < 64; i++) if (board[i] === king) { kingSq = i; break; }
    if (kingSq < 0) return false;
    return this.isSquareAttacked(board, kingSq, color === 'w' ? 'b' : 'w');
  },
  getPseudoMoves(i, board, castling, enPassantTarget, includeCastle) {
    const p = board[i]; if (!p) return [];
    const type = p[1], color = p[0], row = (i >>> 3), col = i & 7;
    const out = [];
    const selfColor = color;
    const add = (r, c) => {
      if (r < 0 || r > 7 || c < 0 || c > 7) return false;
      const j = r*8+c;
      const t = board[j];
      if (!t) { out.push(j); return true; }
      if (t[0] !== selfColor) out.push(j);
      return false;
    };
    if (type === 'P') {
      const d = color === 'w' ? -1 : 1, start = color === 'w' ? 6 : 1;
      if (row + d >= 0 && row + d < 8 && !board[(row+d)*8+col]) {
        out.push((row+d)*8+col);
        if (row === start && !board[(row+2*d)*8+col]) out.push((row+2*d)*8+col);
      }
      for (const dc of [-1, 1]) {
        const r = row + d, c = col + dc;
        if (r < 0 || r > 7 || c < 0 || c > 7) continue;
        const j = r*8+c;
        const t = board[j];
        if (t && t[0] !== selfColor) out.push(j);
        else if (!t && enPassantTarget === j) {
          const enemy = color === 'w' ? 'bP' : 'wP';
          const epSquare = color === 'w' ? (j + 8) : (j - 8);
          if (board[epSquare] === enemy) out.push(j);
        }
      }
    } else if (type === 'N') {
      const mv = [[1,2],[2,1],[-1,2],[-2,1],[1,-2],[2,-1],[-1,-2],[-2,-1]];
      for (let k = 0; k < mv.length; k++) add(row + mv[k][0], col + mv[k][1]);
    } else if (type === 'K') {
      for (let r = row - 1; r <= row + 1; r++) for (let c = col - 1; c <= col + 1; c++) if (r !== row || c !== col) add(r, c);
      if (includeCastle && castling && !this.isInCheckBoard(board, color)) {
        const opp = color === 'w' ? 'b' : 'w';
        const kSide = color === 'w' ? castling.wK : castling.bK;
        const qSide = color === 'w' ? castling.wQ : castling.bQ;
        if (kSide && !board[i+1] && !board[i+2]) {
          if (!this.isSquareAttacked(board, i+1, opp) && !this.isSquareAttacked(board, i+2, opp)) out.push(i+2);
        }
        if (qSide && !board[i-1] && !board[i-2] && !board[i-3]) {
          if (!this.isSquareAttacked(board, i-1, opp) && !this.isSquareAttacked(board, i-2, opp)) out.push(i-2);
        }
      }
    } else {
      const dirs = [];
      if (type === 'B' || type === 'Q') dirs.push([1,1],[1,-1],[-1,1],[-1,-1]);
      if (type === 'R' || type === 'Q') dirs.push([1,0],[-1,0],[0,1],[0,-1]);
      for (let k = 0; k < dirs.length; k++) {
        let r = row + dirs[k][0], c = col + dirs[k][1];
        while (add(r, c)) { r += dirs[k][0]; c += dirs[k][1]; }
      }
    }
    return out;
  },
  isLegalOnBoard(from, to, color, board, ep, castling) {
    const next = this.applyBoardMove(board, from, to, ep);
    return !this.isInCheckBoard(next, color);
  },
  getMovesOnBoard(i, board, ep, castling) {
    const p = board[i]; if (!p) return [];
    const pseudo = this.getPseudoMoves(i, board, castling, ep, true);
    const out = [];
    for (let n = 0; n < pseudo.length; n++) {
      if (this.isLegalOnBoard(i, pseudo[n], p[0], board, ep, castling)) out.push(pseudo[n]);
    }
    return out;
  },
  getMovesFast(i) {
    const board = this.board;
    const p = board[i]; if (!p) return [];
    const key = this.positionKey(board, this.turn, this.enPassantTarget, this.castling) + '|' + i;
    if (this.legalCache && this.legalCache.state === key && this.legalCache.moves[i]) return this.legalCache.moves[i];
    const res = this.getMovesOnBoard(i, board, this.enPassantTarget, this.castling);
    if (!this.legalCache || this.legalCache.state !== key) this.legalCache = { state:key, moves:{} };
    this.legalCache.moves[i] = res;
    return res;
  },
  hasLegalMoveForBoard(color, board, ep, castling) {
    const side = color[0];
    for (let i = 0; i < 64; i++) {
      const p = board[i];
      if (p && p[0] === side) {
        const moves = this.getPseudoMoves(i, board, castling, ep, true);
        for (let n = 0; n < moves.length; n++) {
          if (this.isLegalOnBoard(i, moves[n], side, board, ep, castling)) return true;
        }
      }
    }
    return false;
  },
  opponentHasSufficientMaterial(color) {
    const board = this.board;
    const side = color[0];
    let queens = 0, rooks = 0, bishops = 0, knights = 0, pawns = 0;
    for (let i = 0; i < 64; i++) {
      const p = board[i]; if (!p || p[0] !== side) continue;
      const t = p[1];
      if (t === 'Q') queens++;
      else if (t === 'R') rooks++;
      else if (t === 'B') bishops++;
      else if (t === 'N') knights++;
      else if (t === 'P') pawns++;
    }
    if (queens || rooks || pawns) return true;
    if (bishops + knights >= 2) return true;
    return false;
  },
  isInsufficientMaterial(board) {
    const pieces = [];
    for (let i = 0; i < 64; i++) if (board[i] && board[i][1] !== 'K') pieces.push(board[i]);
    if (!pieces.length) return true;
    if (pieces.length === 1 && (pieces[0][1] === 'B' || pieces[0][1] === 'N')) return true;
    if (pieces.length === 2 && pieces[0][1] === 'B' && pieces[1][1] === 'B' && pieces[0][0] !== pieces[1][0]) {
      const a = board.indexOf(pieces[0]), b = board.indexOf(pieces[1]);
      if (a >= 0 && b >= 0) {
        const ca = (((a>>>3) + (a & 7)) & 1);
        const cb = (((b>>>3) + (b & 7)) & 1);
        return ca === cb;
      }
    }
    return false;
  },
  undoMove() {
    if (!this.history.length) { this.hintText = '还没有可以悔的棋'; this.closeMenu(); return; }
    const h = this.history.pop();
    const currentKey = this.positionKey(this.board, this.turn, this.enPassantTarget, this.castling);
    if (this.positionCounts[currentKey]) {
      if (this.positionCounts[currentKey] > 1) this.positionCounts[currentKey]--;
      else delete this.positionCounts[currentKey];
    }
    this.board = h.board; this.turn = h.turn; this.lastMove = h.last;
    this.castling = h.castling;
    this.enPassantTarget = typeof h.ep === 'number' ? h.ep : -1;
    this.whiteSeconds = h.whiteSeconds; this.blackSeconds = h.blackSeconds;
    this.halfmoveClock = h.halfmoveClock;
    if (h.positionKey) this.positionCounts[h.positionKey] = h.positionCount || 1;
    else if (h.positionCounts) this.positionCounts = h.positionCounts;
    this.sanHistory = h.san || [];
    this.whiteClock = this.formatClock(this.whiteSeconds);
    this.blackClock = this.formatClock(this.blackSeconds);
    this.lastTick = Date.now();
    this.selected = -1; this.legalMoves = []; this.legalCache = {};
    this.resultVisible = false; this.gameOver = false; this.paused = false;
    this.finalResult = ''; this.promotionVisible = false; this.pendingPromotion = null;
    this.hintText = '已悔棋，请继续';
    this.buildSquares();
    this.closeMenu();
    if (!this.gameOver) this.startClock();
  },
  maxBoardLeft() { return Math.min(0, 192 - this.boardSize); },
  maxBoardTop() { return Math.min(0, 280 - this.boardSize); },
  centerOn(i) {
    const col = i & 7, row = (i >>> 3);
    const minLeft = this.maxBoardLeft(), minTop = this.maxBoardTop();
    this.boardLeft = Math.max(minLeft, Math.min(0, 96 - ((col + 0.5) * this.squareSize)|0));
    this.boardTop = Math.max(minTop, Math.min(0, 140 - ((row + 0.5) * this.squareSize)|0));
  },
  onTouchStart(e) { if (e && e.stopPropagation) e.stopPropagation(); if (!e || !e.touches || !e.touches[0]) return; this.touchX = e.touches[0].pageX; this.touchY = e.touches[0].pageY; this.pendingTouchX = this.touchX; this.pendingTouchY = this.touchY; this.dragging = true; this.touchMoved = false; },
  onTouchMove(e) { if (e && e.stopPropagation) e.stopPropagation(); if (e && e.preventDefault) e.preventDefault(); if (!this.dragging || !e || !e.touches || !e.touches[0]) return; this.pendingTouchX = e.touches[0].pageX; this.pendingTouchY = e.touches[0].pageY; if (Math.abs(this.pendingTouchX - this.touchX) > 6 || Math.abs(this.pendingTouchY - this.touchY) > 6) this.touchMoved = true; if (this.touchQueued) return; this.touchQueued = true; const that = this; this.touchTimerId = setTimeout(() => { that.touchTimerId = null; that.touchQueued = false; if (!that.dragging || !that.touchMoved) return; const x = that.pendingTouchX, y = that.pendingTouchY; const minLeft = that.maxBoardLeft(), minTop = that.maxBoardTop(); that.boardLeft = Math.max(minLeft, Math.min(0, that.boardLeft + x - that.touchX)); that.boardTop = Math.max(minTop, Math.min(0, that.boardTop + y - that.touchY)); that.touchX = x; that.touchY = y; }, 16); },
  onTouchEnd(e) { if (this.dragging && !this.touchMoved && e && e.changedTouches && e.changedTouches[0]) { const t = e.changedTouches[0]; const x = typeof t.pageX === 'number' ? t.pageX : t.clientX; const y = (typeof t.pageY === 'number' ? t.pageY : t.clientY) - 74; const col = Math.floor((x - this.boardLeft) / this.squareSize); const row = Math.floor((y - this.boardTop) / this.squareSize); if (col >= 0 && col < 8 && row >= 0 && row < 8) this.tapSquare(row * 8 + col); } this.dragging = false; this.touchQueued = false; this.touchMoved = false; if (this.touchTimerId) { clearTimeout(this.touchTimerId); this.touchTimerId = null; } },
  blockSwipe(e) { if (e && e.stopPropagation) e.stopPropagation(); return false; },
  toggleMenu() { this.menuVisible = true; if (!this.gameOver && !this.resultVisible) { this.paused = true; this.stopClock(); } },
  openMenu() { this.menuVisible = true; if (!this.gameOver && !this.resultVisible) { this.paused = true; this.stopClock(); } },
  closeMenu() {
    this.menuVisible = false;
    if (!this.gameOver && !this.resultVisible && !this.pgnVisible && !this.settingsVisible && !this.promotionVisible) {
      this.paused = false; this.lastTick = Date.now(); this.startClock();
    }
  },
  newGame() { storage.delete({ key: ACTIVE_KEY, fail() {} }); this.newPosition(); this.closeMenu(); },
  offerDraw() {
    this.gameOver = true; this.stopClock(); this.paused = false;
    this.resultTitle = '和棋（双方同意）';
    this.finalResult = '1/2-1/2';
    this.resultVisible = true; this.menuVisible = false;
  },
  confirmResign() {
    this.gameOver = true; this.stopClock(); this.paused = false;
    if (this.confirmBeforeResign) {
      this.resultTitle = (this.turn === WHITE ? '黑方' : '白方') + '胜（对手认输）';
      this.finalResult = this.turn === WHITE ? '0-1' : '1-0';
    } else {
      this.resultTitle = '对局结束';
      this.finalResult = '*';
    }
    this.resultVisible = true; this.menuVisible = false;
  },
  openSettings() { this.menuVisible = false; this.settingsVisible = true; },
  closeSettings() { this.settingsVisible = false; this.persistSettings(); this.menuVisible = true; },
  persistSettings() {
    const payload = {
      showHints: this.showHints,
      autoCenter: this.autoCenter,
      confirmBeforeResign: this.confirmBeforeResign,
      boardSize: this.boardSizeLabel
    };
    storage.set({ key: SETTINGS_KEY, value: JSON.stringify(payload), fail() {} });
  },
  goHome() {
    const params = {}; params[CLEAR_TASK_PARAM] = 'clearTask';
    const target = { uri:'/pages/index', params:params };
    try { router.push(target); }
    catch (e) {
      try { router.replace({ uri:'/pages/index' }); }
      catch (ee) { try { router.back(); } catch (eee) {} }
    }
  },
  exitGame() {
    this.saveGameIfNeeded(function () {
      storage.delete({ key: ACTIVE_KEY, fail() {} });
      this.goHome();
    }.bind(this), true);
  },
  exitFromResult() {
    this.saveGameIfNeeded(function () {
      storage.delete({ key: ACTIVE_KEY, fail() {} });
      this.goHome();
    }.bind(this), true);
  },
  pauseAndSave() {
    const that = this;
    this.paused = true; this.stopClock();
    this.saveGameIfNeeded(function (ok) {
      if (ok || that.savedToHistory) {
        storage.set({
          key: ACTIVE_KEY,
          value: JSON.stringify({ resumeId: that.gameId, at: Date.now(), minutes: that.initialMinutes }),
          success() { that.goHome(); },
          fail() { that.goHome(); }
        });
      } else {
        that.hintText = '至少走4步才能暂停保存';
        that.paused = false; that.lastTick = Date.now(); that.startClock();
        that.closeMenu();
      }
    }, false, true);
  },
  toggleHints() { this.showHints = !this.showHints; this.buildSquares(); },
  toggleAutoCenter() { this.autoCenter = !this.autoCenter; },
  toggleConfirm() { this.confirmBeforeResign = !this.confirmBeforeResign; },
  cycleBoardSize() {
    const n = this.squareSize === 30 ? 44 : (this.squareSize === 44 ? 24 : 30);
    this.applyBoardSize(n);
    this.buildSquares();
  },
  closeResult() { this.gameOver = true; this.resultVisible = false; this.stopClock(); },
  showPGN() { this.menuVisible = false; this.pgnVisible = true; },
  showPGNFromResult() { this.resultVisible = false; this.pgnVisible = true; },
  closePGN() {
    this.pgnVisible = false;
    if (this.resultVisible || this.gameOver) return;
    this.menuVisible = true;
  },
  savePGNOnly() {
    this.saveGameIfNeeded(function () {}, false);
    this.pgnVisible = false;
    this.hintText = '已保存到历史棋局';
  },
  saveAndNew() {
    const that = this;
    this.saveGameIfNeeded(function () { storage.delete({ key: ACTIVE_KEY, fail() {} }); that.newPosition(); }, false);
  },
  buildPGNString() {
    const lines = [];
    lines.push('[Event "Chess · Xiaomi Band 9"]');
    lines.push('[Site "Xiaomi Vela"]');
    const d = new Date();
    const pad = (n) => (n < 10 ? '0' : '') + n;
    lines.push('[Date "' + d.getFullYear() + '.' + pad(d.getMonth()+1) + '.' + pad(d.getDate()) + '"]');
    lines.push('[White "White"]');
    lines.push('[Black "Black"]');
    lines.push('[TimeControl "' + this.timeControlText + '"]');
    lines.push('[Result "' + (this.finalResult || '*') + '"]');
    lines.push('');
    let row = '';
    for (let i = 0; i < this.sanHistory.length; i++) {
      const num = Math.floor(i / 2) + 1;
      if ((i & 1) === 0) {
        if (row) lines.push(row);
        row = num + '. ' + this.sanHistory[i];
      } else row += ' ' + this.sanHistory[i];
    }
    if (row) lines.push(row);
    if (this.finalResult) lines.push(this.finalResult);
    return lines.join('\n');
  },
  buildRecord(isExit, forcePausedSave) {
    const now = Date.now();
    const d = new Date(now);
    const pad = (n) => (n < 10 ? '0' : '') + n;
    const dateStr = d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    const resultVal = this.finalResult || (this.gameOver ? '1/2-1/2' : (forcePausedSave ? '*' : '*'));
    const resultLabel = this.resultTitle || (this.gameOver ? '对局结束' : (forcePausedSave ? '暂停中' : '未完成'));
    return {
      id: this.gameId,
      timestamp: now,
      dateLabel: dateStr,
      moveCount: this.sanHistory.length,
      timeControl: this.timeControlText,
      whiteMinutes: this.initialMinutes || 10,
      whiteSeconds: this.whiteSeconds,
      blackSeconds: this.blackSeconds,
      result: resultVal,
      resultLabel: resultLabel,
      gameOver: !!this.gameOver && !!this.resultVisible,
      paused: !!forcePausedSave,
      san: this.sanHistory.slice(),
      pgn: this.buildPGNString(),
      finalBoard: this.board.slice(),
      finalTurn: this.turn,
      historyStack: this.history.slice(),
      castling: {wK:this.castling.wK,wQ:this.castling.wQ,bK:this.castling.bK,bQ:this.castling.bQ},
      enPassantTarget: this.enPassantTarget,
      lastMove: this.lastMove.slice(),
      halfmoveClock: this.halfmoveClock,
      positionCounts: JSON.parse(JSON.stringify(this.positionCounts))
    };
  },
  saveGameIfNeeded(done, isExit, forcePausedSave) {
    if (this.saveInFlight) { if (done) done(false); return; }
    const moveCount = this.sanHistory.length;
    const threshold = forcePausedSave ? 4 : MIN_MOVES;
    if (moveCount < threshold) {
      if (done) done(false);
      return;
    }
    this.saveInFlight = true;
    const rec = this.buildRecord(!!isExit, !!forcePausedSave);
    const that = this;
    try {
      storage.get({
        key: HISTORY_KEY,
        success(r) {
        try {
          const raw = (r && (r.data !== undefined && r.data !== null)) ? r.data : r;
          const arr = raw ? ((typeof raw === 'string') ? JSON.parse(raw) : raw) : [];
          const list = Array.isArray(arr) ? arr : [];
          let replaced = false;
          for (let i = 0; i < list.length; i++) {
            if (String(list[i].id) === String(that.gameId)) { list[i] = rec; replaced = true; break; }
          }
          if (!replaced) list.unshift(rec);
          while (list.length > MAX_HISTORY) list.pop();
            storage.set({
              key: HISTORY_KEY,
              value: JSON.stringify(list),
              success() { that.saveInFlight = false; that.savedToHistory = true; if (done) done(true); },
              fail() { that.saveInFlight = false; if (done) done(false); }
            });
        } catch (e) { that.saveInFlight = false; if (done) done(false); }
      },
        fail() { that.saveInFlight = false; if (done) done(false); }
      });
    } catch (e) { that.saveInFlight = false; if (done) done(false); }
  }
}
</script>
