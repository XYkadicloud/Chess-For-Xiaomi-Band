<template>
  <div class="page">
    <div class="header"><text class="back" @click="back">‹</text><text class="headerTitle">棋局详情</text></div>
    <div class="metaCard" if="{{record}}">
      <text class="metaRow">结果：{{record.resultLabel}}</text>
      <text class="metaRow">时间：{{record.dateLabel}}</text>
      <text class="metaRow">步数：{{record.moveCount}} · 时限：{{record.timeControl}}</text>
    </div>
    <list class="pgnScroll" if="{{pgnRows.length}}">
      <list-item for="{{pgnRows}}" type="pgnrow" class="pgnRow"><text class="pgnLine">{{$item}}</text></list-item>
    </list>
    <div class="pgnEmpty" if="{{record && !pgnRows.length}}">
      <text class="pgnText">暂无棋谱内容</text>
    </div>
    <div class="bottomActions" if="{{record}}">
      <text class="resumeBtn" if="{{!record.gameOver}}" @click="resumeGame">继续此局</text>
      <text class="delBtn" @click="deleteItem">删除</text>
      <text class="backBtn" @click="back">返回</text>
    </div>
    <div class="emptyWrap" if="{{!record}}">
      <image class="emptyImg" src="/common/images/empty.png"></image>
      <text class="emptyText">记录不存在</text>
    </div>
  </div>
</template>
<style>
.page { width:192dp; height:490dp; background-color:#000000; flex-direction:column; padding:18dp 12dp; overflow:hidden; }
.header { width:168dp; height:42dp; flex-direction:row; align-items:center; margin-bottom:10dp; }
.back { width:32dp; color:#FFFFFF; font-size:30dp; text-align:center; }
.headerTitle { color:#FFFFFF; font-size:22dp; font-weight:bold; }
.metaCard { width:168dp; border-radius:18dp; background-color:#252828; padding:10dp 14dp; margin-bottom:10dp; flex-direction:column; }
.metaRow { color:#FFFFFF; font-size:14dp; line-height:22dp; lines:1; text-overflow:ellipsis; }
.pgnScroll { width:168dp; height:300dp; border-radius:18dp; background-color:#1A1A1A; }
.pgnRow { width:168dp; padding:4dp 10dp; flex-direction:column; min-height:26dp; }
.pgnLine { color:#FFFFFF; font-size:14dp; line-height:22dp; width:100%; lines:1; text-overflow:ellipsis; }
.pgnEmpty { width:168dp; height:80dp; justify-content:center; align-items:center; }
.pgnText { color:rgba(255,255,255,0.6); font-size:14dp; }
.bottomActions { width:168dp; height:46dp; flex-direction:row; justify-content:space-between; align-items:center; margin-top:10dp; }
.resumeBtn { flex:1; height:40dp; border-radius:20dp; background-color:#0D6EFF; color:#FFFFFF; font-size:14dp; text-align:center; line-height:40dp; font-weight:bold; margin-right:4dp; }
.delBtn { flex:1; height:40dp; border-radius:20dp; background-color:#8D2B2B; color:#FFFFFF; font-size:14dp; text-align:center; line-height:40dp; font-weight:bold; margin-left:2dp; margin-right:2dp; }
.backBtn { flex:1; height:40dp; border-radius:20dp; background-color:#252828; color:#FFFFFF; font-size:14dp; text-align:center; line-height:40dp; font-weight:bold; margin-left:4dp; }
.emptyWrap { width:168dp; height:380dp; flex-direction:column; justify-content:center; align-items:center; }
.emptyImg { width:72dp; height:72dp; margin-bottom:16dp; object-fit:contain; }
.emptyText { color:#FFFFFF; font-size:20dp; font-weight:bold; }
</style>
<script>
import router from '@system.router';
import storage from '@system.storage';
const KEY = 'CHESS_GAME_HISTORY';
const ACTIVE_KEY = 'CHESS_ACTIVE_GAME';
export default {
  private: { recordId: '', record: null, pgnRows: [] },
  protected: { id: '' },
  onInit() {
    this.recordId = this.id ? String(this.id) : '';
    this.load();
  },
  load() {
    if (!this.recordId) { this.record = null; this.pgnRows = []; return; }
    const that = this;
    storage.get({
      key: KEY,
      success(res) {
        try {
          const raw = (res && (res.data !== undefined && res.data !== null)) ? res.data : res;
          const arr = raw ? ((typeof raw === 'string') ? JSON.parse(raw) : raw) : [];
          const list = Array.isArray(arr) ? arr : [];
          let found = null;
          for (let i = 0; i < list.length; i++) {
            if (String(list[i].id) === that.recordId) { found = list[i]; break; }
          }
          that.record = found;
          that.pgnRows = that.extractRows(found);
        } catch (e) { that.record = null; that.pgnRows = []; }
      },
      fail() { that.record = null; that.pgnRows = []; }
    });
  },
  extractRows(found) {
    if (!found) return [];
    if (found.pgn && typeof found.pgn === 'string') {
      const cleaned = found.pgn.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
      const lines = cleaned.split('\n').map(s => s.trim()).filter(s => s.length > 0);
      if (lines.length) return lines;
    }
    if (found.san && Array.isArray(found.san)) {
      return this.sanRows(found.san);
    }
    return [];
  },
  sanRows(arr) {
    const rows = [];
    for (let i = 0; i < arr.length; i += 2) {
      const n = Math.floor(i / 2) + 1;
      const w = arr[i] || '';
      const b = arr[i + 1] || '';
      rows.push(n + '. ' + w + (b ? '  ' + b : ''));
    }
    return rows;
  },
  resumeGame() {
    const that = this;
    if (!that.record || !that.record.id) return;
    const active = {
      resumeId: that.record.id,
      at: Date.now()
    };
    storage.set({
      key: ACTIVE_KEY,
      value: JSON.stringify(active),
      success() {
        router.push({ uri: '/pages/game', params: { resume: String(that.record.id), minutes: String(that.record.whiteMinutes || 10) } });
      },
      fail() {
        router.push({ uri: '/pages/game', params: { resume: String(that.record.id), minutes: String(that.record.whiteMinutes || 10) } });
      }
    });
  },
  back() { router.back(); },
  deleteItem() {
    if (!this.recordId) return;
    const that = this;
    storage.get({
      key: KEY,
      success(res) {
        try {
          const raw = (res && (res.data !== undefined && res.data !== null)) ? res.data : res;
          const arr = raw ? ((typeof raw === 'string') ? JSON.parse(raw) : raw) : [];
          const list = Array.isArray(arr) ? arr : [];
          const out = [];
          for (let i = 0; i < list.length; i++) {
            if (String(list[i].id) !== that.recordId) out.push(list[i]);
          }
          storage.set({
            key: KEY,
            value: JSON.stringify(out),
            success() {
              storage.get({
                key: ACTIVE_KEY,
                success(r2) {
                  try {
                    const r = (r2 && (r2.data !== undefined && r2.data !== null)) ? r2.data : r2;
                    if (r) {
                      const parsed = (typeof r === 'string') ? JSON.parse(r) : r;
                      if (parsed && String(parsed.resumeId) === that.recordId) {
                        storage.delete({ key: ACTIVE_KEY, fail() {} });
                      }
                    }
                  } catch (e) {}
                  router.back();
                },
                fail() { router.back(); }
              });
            },
            fail() { router.back(); }
          });
        } catch (e) { router.back(); }
      },
      fail() { router.back(); }
    });
  }
}
</script>
