<template><div class="page"><text class="back" @click="goBack">‹ 返回</text><text class="title">搜索结果</text><text class="query">{{query}}</text><list class="list"><list-item type="linear" for="{{items}}" class="item" @click="openItem($item)"><text class="main">{{$item.title}}</text><text class="sub">{{$item.summary}}</text></list-item><list-item type="linear" class="item more" @click="nextPage"><text class="moreMain">{{loading ? '加载中...' : '下一页'}}</text></list-item></list></div></template>
<style>.page{width:192px;height:490px;background-color:#000;padding:12px 10px}.back{width:60px;color:#9fd4ff;font-size:15px}.title{width:172px;text-align:center;color:#fff;font-size:19px;font-weight:bold}.query{width:172px;margin:3px 0;color:rgba(255,255,255,.55);font-size:12px;text-overflow:ellipsis;lines:1}.list{width:172px;height:390px;padding:8px 0}.item{width:172px;height:65px;margin-bottom:6px;padding:8px 10px;background-color:#262626;border-radius:20px;flex-direction:column;justify-content:space-between}.main{color:#fff;font-size:15px;font-weight:bold;text-overflow:ellipsis;lines:1}.sub{color:rgba(255,255,255,.62);font-size:11px;text-overflow:ellipsis;lines:2}.more{justify-content:center}.moreMain{width:172px;text-align:center;color:#9fd4ff;font-size:15px;font-weight:bold}</style>
<script>
import router from '@system.router'; import { searchDuckDuckGo } from '../../common/js/search'
export default { data:{query:'',items:[],page:0,loading:false}, onInit(){this.query=this.$page.query||'';this.load()}, goBack(){router.back()}, load(){this.loading=true;searchDuckDuckGo(this.query,this.page).then(v=>{this.items=v;this.loading=false}).catch((err)=>{this.items=[{title:'搜索失败',summary:String(err&&err.message||'请确认 SimpleFetch 已连接'),url:''}];this.loading=false})}, nextPage(){if(!this.loading){this.page++;this.load()}}, openItem(item){if(item.url)router.push({uri:'/pages/reader',params:{url:item.url,title:item.title}})} }
</script>
