<template><div class="page"><text class="back" @click="goBack">‹ 返回</text><text class="title">{{title}}</text><list class="list"><list-item type="linear" class="textItem"><text class="body">{{pageText}}</text></list-item><list-item type="linear" class="item" if="{{links.length > 0}}"><text class="linkTitle">页面文字链接</text></list-item><list-item type="linear" for="{{links}}" class="linkItem" @click="openLink($item)"><text class="linkText">{{$item.text}}</text></list-item></list></div></template>
<style>.page{width:192px;height:490px;background-color:#000;padding:12px 10px}.back{width:60px;color:#9fd4ff;font-size:15px}.title{width:172px;margin:0;color:#fff;font-size:18px;font-weight:bold;text-overflow:ellipsis;lines:2}.list{width:172px;height:420px;padding:8px 0}.textItem{width:172px;padding:8px 10px;background-color:#171717;border-radius:16px;margin-bottom:6px}.body{width:152px;color:rgba(255,255,255,.9);font-size:14px;line-height:20px}.linkTitle{width:172px;color:#9fd4ff;font-size:15px;font-weight:bold}.linkItem{width:172px;height:46px;padding:8px 10px;background-color:#262626;border-radius:16px;margin-bottom:5px}.linkText{width:152px;color:#6eb1ff;font-size:14px;text-overflow:ellipsis;lines:2}</style>
<script>
import router from '@system.router'; import { readPage } from '../../common/js/search'
export default { data:{url:'',title:'网页',pageText:'正在加载...',links:[]}, onInit(){this.url=this.$page.url||'';this.title=this.$page.title||this.url;readPage(this.url).then(p=>{this.title=p.title;this.pageText=p.text;this.links=p.links.slice(0,12)}).catch(()=>{this.pageText='网页加载失败，请检查桥接网络或返回重试。'})}, goBack(){router.back()}, openLink(item){router.push({uri:'/pages/reader',params:{url:item.url,title:item.text}})} }
</script>
