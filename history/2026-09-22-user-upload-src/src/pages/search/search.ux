<template>
  <div class="page">
    <text class="back" @click="goBack">‹ 返回</text>
    <text class="title">搜索</text>
    <div class="queryBox">
      <text class="queryLabel">关键词</text>
      <text class="queryText">{{query || '点击键盘输入'}}</text>
    </div>
    <div class="actionRow">
      <text class="searchButton" @click="submit">搜索</text>
      <text class="clearButton" @click="clear">清除</text>
    </div>
    <div class="keyboard">
      <div class="keyRow"><text class="key" @click="add('Q')">Q</text><text class="key" @click="add('W')">W</text><text class="key" @click="add('E')">E</text><text class="key" @click="add('R')">R</text><text class="key" @click="add('T')">T</text><text class="key" @click="add('Y')">Y</text></div>
      <div class="keyRow"><text class="key" @click="add('A')">A</text><text class="key" @click="add('S')">S</text><text class="key" @click="add('D')">D</text><text class="key" @click="add('F')">F</text><text class="key" @click="add('G')">G</text><text class="key" @click="add('H')">H</text></div>
      <div class="keyRow"><text class="key" @click="add('Z')">Z</text><text class="key" @click="add('X')">X</text><text class="key" @click="add('C')">C</text><text class="key" @click="add('V')">V</text><text class="key" @click="add('B')">B</text><text class="key" @click="add('N')">N</text></div>
      <div class="keyRow"><text class="wideKey" @click="add('M')">M</text><text class="wideKey" @click="add(' ')">空格</text><text class="wideKey danger" @click="backspace">⌫</text></div>
    </div>
    <text class="status">{{statusText}}</text>
  </div>
</template>
<style>
.page{width:192px;height:490px;background-color:#000;padding:12px 10px;flex-direction:column}.back{width:60px;color:#9fd4ff;font-size:15px;height:24px}.title{width:172px;text-align:center;color:#fff;font-size:20px;font-weight:bold;height:28px}.queryBox{width:172px;height:55px;background-color:#262626;border-radius:18px;padding:7px 10px;flex-direction:column}.queryLabel{color:rgba(255,255,255,.55);font-size:11px;height:16px}.queryText{color:#fff;font-size:17px;height:24px;text-overflow:ellipsis;lines:1}.actionRow{width:172px;height:42px;flex-direction:row;justify-content:space-between;align-items:center}.searchButton{width:108px;height:34px;text-align:center;padding-top:6px;background-color:#0d6eff;color:#fff;border-radius:17px;font-size:15px}.clearButton{width:54px;height:34px;text-align:center;padding-top:6px;background-color:#262626;color:#9fd4ff;border-radius:17px;font-size:13px}.keyboard{width:172px;height:190px;padding-top:4px;background-color:#111;flex-direction:column}.keyRow{width:172px;height:44px;flex-direction:row;justify-content:space-between;align-items:center}.key{width:25px;height:34px;padding-top:7px;text-align:center;background-color:#262d2b;color:#fff;border-radius:17px;font-size:15px}.wideKey{width:48px;height:34px;padding-top:7px;text-align:center;background-color:#262d2b;color:#fff;border-radius:17px;font-size:13px}.danger{background-color:#4a2323;color:#ffb3ad}.status{width:172px;text-align:center;color:rgba(255,255,255,.48);font-size:11px;height:20px;padding-top:4px}
</style>
<script>
import router from '@system.router'
import { handshake, getStatus } from '../../common/js/bridge'
export default { data:{query:'',statusText:'连接中...'}, onShow(){this.statusText=getStatus()==='bridge'?'桥接已连接':'等待手机桥接';handshake().catch(()=>{this.statusText='请先在 AstroBox 配对'})}, goBack(){router.back()}, add(value){if(this.query.length<20)this.query+=value}, backspace(){this.query=this.query.slice(0,-1)}, clear(){this.query=''}, submit(){const q=(this.query||'').trim();if(!q){this.statusText='请输入关键词';return}if(getStatus()!=='bridge'){this.statusText='桥接未连接';handshake().catch(()=>{});return}router.push({uri:'/pages/results',params:{query:q}})} }
</script>
