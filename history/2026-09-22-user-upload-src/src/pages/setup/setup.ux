<template>
  <div class="setup">
    <div class="head"><text class="back" @click="back">‹</text><text class="title">开始对局</text></div>
    <text class="label">选择每方用时</text>
    <text class="time" @click="choose('3+0')">3 分钟 · 快棋</text>
    <text class="time" @click="choose('5+0')">5 分钟 · 标准</text>
    <text class="time" @click="choose('10+0')">10 分钟 · 休闲</text>
    <text class="time" @click="choose('15+0')">15 分钟 · 长局</text>
    <text class="time selected" @click="choose('20+0')">20 分钟 · 耐心</text>
    <text class="selectedText">当前：{{timeControl}}</text>
    <text class="selectedText">棋盘：{{boardSize}}</text>
    <text class="start" @click="start">开始下棋</text>
  </div>
</template>
<style>
.setup { width:192dp; height:490dp; background-color:#000; padding:18dp 12dp; flex-direction:column; overflow:hidden; }
.head { width:168dp; height:42dp; flex-direction:row; align-items:center; margin-bottom:12dp; }
.back { width:32dp; color:#fff; font-size:30dp; text-align:center; }
.title { color:#fff; font-size:22dp; font-weight:bold; }
.label { color:rgba(255,255,255,.65); font-size:15dp; margin-bottom:6dp; }
.time { width:168dp; height:38dp; border-radius:19dp; background-color:#252828; color:#fff; font-size:16dp; line-height:38dp; text-align:center; margin-bottom:5dp; }
.selected { background-color:#0D6EFF; }
.selectedText { color:#4EA1FF; font-size:14dp; text-align:center; margin:7dp 0 0; }
.start { position:absolute; left:12dp; bottom:14dp; width:168dp; height:44dp; border-radius:22dp; background-color:#0D6EFF; color:#fff; font-size:18dp; line-height:44dp; text-align:center; }
</style>
<script>
import router from '@system.router';
import storage from '@system.storage';
export default { data:{timeControl:'10+0',boardSize:'标准'}, onInit(){this.loadBoardSize();}, onShow(){this.loadBoardSize();}, loadBoardSize(){storage.get({key:'CHESS_SETTINGS',success:(r)=>{try{const raw=r&&r.data!==undefined?r.data:r;const v=typeof raw==='string'?JSON.parse(raw):raw;this.boardSize=v&&v.boardSize?v.boardSize:'标准';}catch(e){this.boardSize='标准';}},fail:()=>{this.boardSize='标准';}});}, back(){router.back();}, choose(v){this.timeControl=v;}, start(){const go=(size)=>{const px=size==='放大'?44:(size==='紧凑'?24:30);storage.set({key:'CHESS_LAUNCH_BOARD_SIZE',value:String(px),success:()=>router.push({uri:'/pages/game',params:{minutes:this.timeControl.split('+')[0]}}),fail:()=>router.push({uri:'/pages/game',params:{minutes:this.timeControl.split('+')[0]}})});};storage.get({key:'CHESS_SETTINGS',success:(r)=>{try{const raw=r&&r.data!==undefined?r.data:r;const v=typeof raw==='string'?JSON.parse(raw):raw;go(v&&v.boardSize?v.boardSize:this.boardSize);}catch(e){go(this.boardSize);}},fail:()=>go(this.boardSize)});} }
</script>
