<template>
  <div class="page">
    <div class="header">
      <text class="back" @touchend="back">‹</text>
      <text class="headerTitle">{{$t('about.title')}}</text>
    </div>
    <list class="aboutList">
      <list-item class="appItem" type="item">
        <image class="appIcon" src="/common/icon.png"></image>
        <text class="appName">Chess</text>
        <text class="version">{{versionText}}</text>
      </list-item>
      <list-item class="authorItem" type="item">
        <image class="avatar" src="/common/avatar.jpg"></image>
        <div class="authorInfo">
          <text class="authorLabel">{{$t('about.developer')}}</text>
          <text class="developer">XYKadi</text>
        </div>
      </list-item>
      <list-item class="infoItem" type="item">
        <text class="sectionTitle">{{$t('about.aboutApp')}}</text>
        <text class="bodyText">{{$t('about.aboutAppBody')}}</text>
      </list-item>
      <list-item class="infoItem rulesItem" type="item">
        <text class="sectionTitle">{{$t('about.supportedRules')}}</text>
        <text class="bodyText">{{$t('about.supportedRulesBody')}}</text>
      </list-item>
      <list-item class="infoItem rulesItem" type="item">
        <text class="sectionTitle">{{$t('about.notSupported')}}</text>
        <text class="bodyText">{{$t('about.notSupportedBody')}}</text>
      </list-item>
      <list-item class="infoItem creditsItem" type="item">
        <text class="sectionTitle">{{$t('about.pieces')}}</text>
        <text class="bodyText">{{$t('about.piecesBody')}}</text>
      </list-item>
      <list-item class="supportItem" type="item" @touchend="openQr">
        <text class="sectionTitle supportTitle">{{$t('about.afdian')}}</text>
        <text class="supportText">{{$t('about.afdianBody')}}</text>
        <image class="qrPreview" src="/common/aifadian_qr.jpg"></image>
        <text class="qrButton">{{$t('about.afdianButton')}}</text>
      </list-item>
      <list-item class="purchaseEntryItem" type="item" @touchend="openPurchase">
        <text class="purchaseEntry">{{$t('about.goPay')}}</text>
      </list-item>
      <list-item class="thanksItem" type="item">
        <text class="thanks">{{$t('about.thanks')}}</text>
      </list-item>
    </list>
  </div>
</template>
<style>
.page { width:212dp; height:520dp; background-color:#000000; flex-direction:column; }
.header { width:212dp; height:52dp; position:relative; align-items:center; justify-content:center; }
.back { position:absolute; left:12dp; top:8dp; width:32dp; height:36dp; color:#FFFFFF; font-size:30dp; line-height:36dp; text-align:center; }
.headerTitle { width:212dp; color:#FFFFFF; font-size:21dp; font-weight:bold; line-height:36dp; text-align:center; }
.aboutList { width:212dp; height:438dp; padding:8dp 12dp 28dp 12dp; }
.appItem,.authorItem,.infoItem,.supportItem,.purchaseEntryItem { width:188dp; margin-bottom:10dp; border-radius:16dp; background-color:#252828; align-items:center; }
.appItem { height:150dp; flex-direction:column; justify-content:center; }
.appIcon { width:68dp; height:68dp; object-fit:contain; margin-bottom:4dp; }
.appName { color:#FFFFFF; font-size:20dp; font-weight:bold; line-height:26dp; }
.version { color:#4EA1FF; font-size:16dp; font-weight:bold; line-height:23dp; }
.authorItem { height:92dp; padding:10dp 16dp; flex-direction:row; justify-content:flex-start; }
.avatar { width:68dp; height:68dp; border-radius:34dp; object-fit:cover; background-color:#101010; margin-right:16dp; }
.authorInfo { height:62dp; flex-direction:column; justify-content:center; }
.authorLabel { color:rgba(255,255,255,0.6); font-size:14dp; line-height:21dp; }
.developer { color:#FFFFFF; font-size:20dp; font-weight:bold; line-height:28dp; }
.creditsItem { height:104dp; }
.infoItem { height:146dp; padding:14dp 14dp 12dp 14dp; flex-direction:column; align-items:flex-start; justify-content:flex-start; }
.rulesItem { height:157dp; }
.sectionTitle { width:160dp; color:#FFFFFF; font-size:16dp; font-weight:bold; line-height:23dp; margin-bottom:5dp; }
.bodyText { width:160dp; color:rgba(255,255,255,0.78); font-size:12dp; line-height:17dp; }
.supportItem { height:320dp; padding:14dp 10dp 16dp 10dp; flex-direction:column; justify-content:flex-start; }
.supportTitle { width:168dp; text-align:center; }
.supportText { width:168dp; height:38dp; lines:2; text-overflow:clip; color:rgba(255,255,255,0.78); font-size:13dp; line-height:19dp; text-align:center; margin-bottom:10dp; }
.qrPreview { width:160dp; height:160dp; background-color:#FFFFFF; object-fit:contain; }
.qrButton { width:150dp; height:34dp; margin-top:8dp; border-radius:17dp; background-color:#0D6EFF; color:#FFFFFF; font-size:13dp; line-height:34dp; text-align:center; }
.purchaseEntryItem { height:54dp; justify-content:center; }
.purchaseEntry { width:150dp; height:38dp; border-radius:19dp; background-color:#0D6EFF; color:#FFFFFF; font-size:16dp; font-weight:bold; line-height:38dp; text-align:center; }
.thanksItem { width:188dp; height:50dp; align-items:center; justify-content:center; background-color:#000000; }
.thanks { color:rgba(255,255,255,0.45); font-size:13dp; text-align:center; }
</style>
<script>
import router from '@system.router';
import storage from '@system.storage';
export default {
  computed:{
    versionText(){ return this.$t('about.version'); }
  },
  data:{purchaseConfirmed:false},
  onInit(){this.loadPurchase();},
  onShow(){this.loadPurchase();},
  loadPurchase(){storage.get({key:'purchase_confirmed',success:(r)=>{const raw=r&&r.data!==undefined?r.data:r;this.purchaseConfirmed=raw===true||String(raw)==='true';},fail:()=>{this.purchaseConfirmed=false;}});},
  back(){router.back();},
  openQr(){router.push({uri:'/pages/support'});},
  openPurchase(){router.push({uri:'/pages/purchase'});}
}
</script>
