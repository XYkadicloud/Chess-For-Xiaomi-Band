<template>
  <div class="purchasePage">
    <div class="header"><text class="headerTitle">{{tt_purchase_title}}</text></div>
    <list class="purchaseList">
      <list-item class="qrItem" type="item">
        <image class="qr" src="/common/aifadian_qr.jpg"></image>
      </list-item>
      <list-item class="priceItem" type="item">
        <text class="price">{{tt_purchase_price}}</text>
        <text class="bodyText priceText">{{tt_purchase_priceText}}</text>
      </list-item>
      <list-item class="infoItem" type="item">
        <text class="bodyText leftText tokenText">{{tt_purchase_tokenText}}</text>
        <text class="bodyText leftText gap featureText">{{tt_purchase_featureText}}</text>
      </list-item>
      <list-item class="browserItem" type="item">
        <text class="bodyText leftText projectText">{{tt_purchase_projectText}}</text>
        <text class="bodyText leftText gap browserText">{{tt_purchase_browserText}}</text>
      </list-item>
    </list>
    <div class="buttonArea" if="{{!purchaseConfirmed}}">
      <text class="confirmButton" @touchend="confirmPurchase">{{tt_purchase_confirm}}</text>
    </div>
  </div>
</template>
<style>
.purchasePage { width:212dp; height:520dp; background-color:#000000; flex-direction:column; }
.header { width:212dp; height:52dp; align-items:center; justify-content:center; }
.headerTitle { color:#FFFFFF; font-size:21dp; font-weight:bold; line-height:36dp; }
.purchaseList { width:212dp; height:374dp; padding:6dp 12dp 14dp 12dp; }
.qrItem,.priceItem,.infoItem,.browserItem { width:188dp; border-radius:16dp; background-color:#252828; margin-bottom:8dp; padding:10dp 14dp; flex-direction:column; align-items:center; justify-content:flex-start; }
.qrItem { height:188dp; padding:9dp; }
.qr { width:150dp; height:150dp; background-color:#FFFFFF; object-fit:contain; }
.priceItem { height:82dp; align-items:center; justify-content:flex-start; }
.price { color:#4EA1FF; font-size:22dp; font-weight:bold; line-height:28dp; }
.infoItem { height:180dp; align-items:flex-start; }
.browserItem { height:180dp; align-items:flex-start; }
.bodyText { width:160dp; color:rgba(255,255,255,0.82); font-size:13dp; line-height:19dp; text-align:center; }
.priceText { height:38dp; lines:2; text-overflow:clip; margin-top:2dp; }
.leftText { text-align:left; }
.tokenText,.projectText { height:38dp; lines:2; text-overflow:clip; }
.featureText,.browserText { height:114dp; lines:6; text-overflow:clip; }
.gap { margin-top:7dp; }
.buttonArea { width:212dp; height:64dp; align-items:center; justify-content:center; }
.confirmButton { width:160dp; height:44dp; border-radius:22dp; background-color:#0D6EFF; color:#FFFFFF; font-size:18dp; font-weight:bold; line-height:44dp; text-align:center; }
</style>
<script>
import router from '@system.router';
import configuration from '@system.configuration';
import { tr, initLang, setLang, setSystemLang, resolveLang } from '../../common/js/strings.js';
import storage from '@system.storage';
export default {
  onShow(){ this.applyLang(); },
  computed:{
    tt_purchase_priceText(){ this.langTick; return tr('purchase.priceText'); },
    tt_purchase_tokenText(){ this.langTick; return tr('purchase.tokenText'); },
    tt_purchase_featureText(){ this.langTick; return tr('purchase.featureText'); },
    tt_purchase_projectText(){ this.langTick; return tr('purchase.projectText'); },
    tt_purchase_browserText(){ this.langTick; return tr('purchase.browserText'); },
    tt_purchase_title(){ this.langTick; return tr('purchase.title'); },
    tt_purchase_price(){ this.langTick; return tr('purchase.price'); },
    tt_purchase_confirm(){ this.langTick; return tr('purchase.confirm'); },
  },
  tr(k){ return tr(k); },
  applyLang(){
    let devLang = 'en';
    try{
      const loc = configuration.getLocale();
      devLang = (loc && loc.language === 'zh') ? 'zh' : 'en';
    }catch(e){ devLang = 'en'; }
    initLang({ language: devLang });
    storage.get({key:'CHESS_SETTINGS',success:(data)=>{
      try{
        const raw=data&&data.data!==undefined?data.data:data;
        const v=(raw===undefined||raw===null||raw==='')?null:(typeof raw==='string'?JSON.parse(raw):raw);
        setLang(resolveLang(v&&v.langMode, devLang));
      }catch(e){ setLang('system'); }
      this.langTick=(this.langTick||0)+1;
    },fail:()=>{ setLang('system'); this.langTick=(this.langTick||0)+1; }});
  },
  protected:{firstLaunch:'false'},
  data:{ langTick:0,purchaseConfirmed:false},
  onInit(){ this.applyLang(); this.loadPurchase();},
  loadPurchase(){storage.get({key:'purchase_confirmed',success:(r)=>{const raw=r&&r.data!==undefined?r.data:r;this.purchaseConfirmed=raw===true||String(raw)==='true';},fail:()=>{this.purchaseConfirmed=false;}});},
  confirmPurchase(){storage.set({key:'purchase_confirmed',value:'true'});this.purchaseConfirmed=true;if(this.firstLaunch==='true')router.replace({uri:'/pages/index'});else router.back();}
}
</script>
