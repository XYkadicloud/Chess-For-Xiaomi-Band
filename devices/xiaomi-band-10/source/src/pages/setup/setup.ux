<template>
  <div class="setup">
    <div class="head"><text class="back" @click="back">‹</text><text class="title">Start game</text></div>
    <text class="label">Time per player</text>
    <text class="{{timeControl === '5+0' ? 'time selected' : 'time'}}" @touchend="choose('5+0')">5 min · Standard</text>
    <text class="{{timeControl === '10+0' ? 'time selected' : 'time'}}" @touchend="choose('10+0')">10 min · Casual</text>
    <text class="{{timeControl === '15+0' ? 'time selected' : 'time'}}" @touchend="choose('15+0')">15 min · Long game</text>
    <text class="{{timeControl === '20+0' ? 'time selected' : 'time'}}" @touchend="choose('20+0')">20 min · Patient</text>
    <text class="{{timeControl === 'unlimited' ? 'time selected' : 'time'}}" @touchend="choose('unlimited')">Unlimited time</text>
    <text class="selectedText">Current: {{timeControl === 'unlimited' ? 'Unlimited' : timeControl}}</text>
    <text class="selectedText">Board: {{boardSize}}</text>
    <text class="start" @touchend="start">Start playing</text>
  </div>
</template>
<style>
.setup { width:212dp; height:520dp; background-color:#000; padding:18dp 12dp; flex-direction:column; overflow:hidden; }
.head { width:188dp; height:42dp; flex-direction:row; align-items:center; margin-bottom:12dp; }
.back { width:32dp; color:#fff; font-size:30dp; text-align:center; }
.title { color:#fff; font-size:22dp; font-weight:bold; }
.label { color:rgba(255,255,255,.65); font-size:15dp; margin-bottom:6dp; }
.time { width:188dp; height:38dp; border-radius:19dp; background-color:#252828; color:#fff; font-size:16dp; line-height:38dp; text-align:center; margin-bottom:5dp; }
.selected { background-color:#0D6EFF; }
.selectedText { color:#4EA1FF; font-size:14dp; text-align:center; margin:7dp 0 0; }
.start { position:absolute; left:12dp; bottom:14dp; width:188dp; height:44dp; border-radius:22dp; background-color:#0D6EFF; color:#fff; font-size:18dp; line-height:44dp; text-align:center; }
</style>
<script>
import router from '@system.router';
import storage from '@system.storage';
export default { data:{timeControl:'10+0',boardSize:'Standard'}, onInit(){this.loadBoardSize();}, onShow(){this.loadBoardSize();}, loadBoardSize(){storage.get({key:'CHESS_SETTINGS',success:(r)=>{try{const raw=r&&r.data!==undefined?r.data:r;const v=typeof raw==='string'?JSON.parse(raw):raw;const oldSize=v&&v.boardSize;this.boardSize=oldSize==='Large'||oldSize==='\u653e\u5927'?'Large':(oldSize==='Compact'||oldSize==='\u7d27\u51d1'?'Compact':'Standard');}catch(e){this.boardSize='Standard';}},fail:()=>{this.boardSize='Standard';}});}, back(){router.back();}, choose(v){this.timeControl=v;}, start(){const unlimited=this.timeControl==='unlimited';const minutes=unlimited?'0':(this.timeControl.split('+')[0]||'10');const size=this.boardSize==='Large'?'44':(this.boardSize==='Compact'?'24':'30');router.push({uri:'/pages/game',params:{minutes:minutes,unlimited:unlimited?'true':'false',boardSize:size,resume:'false'}});} }
</script>
