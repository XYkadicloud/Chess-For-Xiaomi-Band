.avatar { width:68dp; height:68dp; border-radius:34dp; object-fit:cover; background-color:#101010; margin-right:16dp; }
.authorInfo { height:62dp; flex-direction:column; justify-content:center; }
.authorLabel { color:rgba(255,255,255,0.6); font-size:14dp; line-height:21dp; }
.developer { color:#FFFFFF; font-size:20dp; font-weight:bold; line-height:28dp; }
.creditsItem { height:104dp; }
.infoItem { height:138dp; padding:14dp 14dp 12dp 14dp; flex-direction:column; align-items:flex-start; justify-content:flex-start; }
.rulesItem { height:165dp; }
.sectionTitle { width:160dp; color:#FFFFFF; font-size:16dp; font-weight:bold; line-height:23dp; margin-bottom:5dp; }
.bodyText { width:160dp; color:rgba(255,255,255,0.78); font-size:11dp; line-height:15dp; }
.supportItem { height:320dp; padding:14dp 10dp 16dp 10dp; flex-direction:column; justify-content:flex-start; }
.supportTitle { width:168dp; text-align:center; }
.supportText { width:168dp; height:38dp; lines:2; text-overflow:clip; color:rgba(255,255,255,0.78); font-size:13dp; line-height:19dp; text-align:center; margin-bottom:10dp; }
.qrPreview { width:160dp; height:160dp; background-color:#FFFFFF; object-fit:contain; }
.qrButton { width:150dp; height:34dp; margin-top:8dp; border-radius:17dp; background-color:#0D6EFF; color:#FFFFFF; font-size:13dp; line-height:34dp; text-align:center; }
.purchaseEntryItem { height:54dp; justify-content:center; }
.purchaseEntry { width:150dp; height:38dp; border-radius:19dp; background-color:#0D6EFF; color:#FFFFFF; font-size:16dp; font-weight:bold; line-height:38dp; text-align:center; }
.thanksItem { width:188dp; height:50dp; align-items:center; justify-content:center; background-color:#000000; }
.thanks { color:rgba(255,255,255,0.45); font-size:13dp; text-align:center; }
</style>
<script>
import router from '@system.router';
import storage from '@system.storage';
export default {
  data:{purchaseConfirmed:false},
  onInit(){this.loadPurchase();},
  onShow(){this.loadPurchase();},
  loadPurchase(){storage.get({key:'purchase_confirmed',success:(r)=>{const raw=r&&r.data!==undefined?r.data:r;this.purchaseConfirmed=raw===true||String(raw)==='true';},fail:()=>{this.purchaseConfirmed=false;}});},
  back(){router.back();},
  openQr(){router.push({uri:'/pages/support'});},
  openPurchase(){router.push({uri:'/pages/purchase'});}
}
</script>
