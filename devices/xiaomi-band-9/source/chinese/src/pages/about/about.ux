<template>
  <div class="page">
    <div class="header">
      <text class="back" @touchend="back">‹</text>
      <text class="headerTitle">{{tt_about_title}}</text>
    </div>
    <list class="aboutList">
      <list-item class="appItem" type="item">
        <image class="appIcon" src="/common/icon.png"></image>
        <text class="appName">Chess</text>
        <text class="version">{{versionText}}</text>
      </list-item>
      <list-item class="authorItem" type="item">
        <image class="avatar" src="/common/avatar.jpg"></image>
        <div class="authorInfo">
          <text class="authorLabel">{{tt_about_developer}}</text>
          <text class="developer">XYKadi</text>
        </div>
      </list-item>
      <list-item class="infoItem" type="item">
        <text class="sectionTitle">{{tt_about_aboutApp}}</text>
        <text class="bodyText">{{tt_about_aboutAppBody}}</text>
      </list-item>
      <list-item class="infoItem rulesItem" type="item">
        <text class="sectionTitle">{{tt_about_supportedRules}}</text>
        <text class="bodyText">{{tt_about_supportedRulesBody}}</text>
      </list-item>
      <list-item class="infoItem rulesItem" type="item">
        <text class="sectionTitle">{{tt_about_notSupported}}</text>
        <text class="bodyText">{{tt_about_notSupportedBody}}</text>
      </list-item>
      <list-item class="infoItem creditsItem" type="item">
        <text class="sectionTitle">{{tt_about_pieces}}</text>
        <text class="bodyText">{{tt_about_piecesBody}}</text>
      </list-item>
      <list-item class="supportItem" type="item" @touchend="openQr">
        <text class="sectionTitle supportTitle">{{tt_about_afdian}}</text>
        <text class="supportText">{{tt_about_afdianBody}}</text>
        <image class="qrPreview" src="/common/aifadian_qr.jpg"></image>
        <text class="qrButton">{{tt_about_afdianButton}}</text>
      </list-item>
      <list-item class="thanksItem" type="item">
        <text class="thanks">{{tt_about_thanks}}</text>
      </list-item>
    </list>
  </div>
</template>
<style>
.page { width:192dp; height:490dp; background-color:#000000; flex-direction:column; }
.header { width:192dp; height:52dp; position:relative; align-items:center; justify-content:center; }
.back { position:absolute; left:12dp; top:8dp; width:32dp; height:36dp; color:#FFFFFF; font-size:30dp; line-height:36dp; text-align:center; }
.headerTitle { width:192dp; color:#FFFFFF; font-size:21dp; font-weight:bold; line-height:36dp; text-align:center; }
.aboutList { width:192dp; height:438dp; padding:8dp 12dp 28dp 12dp; }
.appItem,.authorItem,.infoItem,.supportItem { width:168dp; margin-bottom:10dp; border-radius:16dp; background-color:#252828; align-items:center; }
.appItem { height:150dp; flex-direction:column; justify-content:center; }
.appIcon { width:68dp; height:68dp; object-fit:contain; margin-bottom:4dp; }
.appName { color:#FFFFFF; font-size:20dp; font-weight:bold; line-height:26dp; }
.version { color:#4EA1FF; font-size:16dp; font-weight:bold; line-height:23dp; }
.authorItem { height:92dp; padding:10dp 16dp; flex-direction:row; justify-content:flex-start; }
.avatar { width:68dp; height:68dp; border-radius:34dp; object-fit:cover; background-color:#101010; margin-right:16dp; }
.authorInfo { height:62dp; flex-direction:column; justify-content:center; }
.authorLabel { color:rgba(255,255,255,0.6); font-size:14dp; line-height:21dp; }
.developer { color:#FFFFFF; font-size:20dp; font-weight:bold; line-height:28dp; }
.creditsItem { height:104dp; }
.infoItem { min-height:165dp; padding:14dp 14dp 12dp 14dp; flex-direction:column; align-items:flex-start; justify-content:flex-start; }
.rulesItem { height:128dp; }
.sectionTitle { width:140dp; color:#FFFFFF; font-size:16dp; font-weight:bold; line-height:23dp; margin-bottom:5dp; }
.bodyText { width:140dp; color:rgba(255,255,255,0.78); font-size:11dp; line-height:15dp; }
.supportItem { height:270dp; padding:14dp 10dp 16dp 10dp; flex-direction:column; justify-content:flex-start; }
.supportTitle { width:148dp; text-align:center; }
.supportText { width:148dp; color:rgba(255,255,255,0.78); font-size:13dp; line-height:19dp; text-align:center; margin-bottom:10dp; }
.qrPreview { width:160dp; height:160dp; background-color:#FFFFFF; object-fit:contain; }
.qrButton { width:150dp; height:34dp; margin-top:8dp; border-radius:17dp; background-color:#0D6EFF; color:#FFFFFF; font-size:13dp; line-height:34dp; text-align:center; }
.thanksItem { width:168dp; height:50dp; align-items:center; justify-content:center; background-color:#000000; }
.thanks { color:rgba(255,255,255,0.45); font-size:13dp; text-align:center; }
</style>
<script>
import router from '@system.router';
import configuration from '@system.configuration';
import storage from '@system.storage';
import { tr, initLang, setLang, setSystemLang, resolveLang } from '../../common/js/strings.js';
export default {
  onInit(){ this.applyLang(); },
  tr(k){ return tr(k); },
  applyLang(){
    let devLang = 'en';
    try{
      const loc = configuration.getLocale();
      devLang = (loc && loc.language === 'zh') ? 'zh' : 'en';
    }catch(e){ devLang = 'en'; }
    initLang({ language: devLang });
    storage.get({key:'CHESS_SETTINGS',success:(data)=>{
      try{
        const raw=data&&data.data!==undefined?data.data:data;
        const v=(raw===undefined||raw===null||raw==='')?null:(typeof raw==='string'?JSON.parse(raw):raw);
        setLang(resolveLang(v&&v.langMode, devLang));
      }catch(e){ setLang('system'); }
      this.langTick=(this.langTick||0)+1;
    },fail:()=>{ setLang('system'); this.langTick=(this.langTick||0)+1; }});
  },
  computed:{
    versionText(){ return tr('about.version'); }
  },
  back(){router.back();},
  openQr(){router.push({uri:'/pages/support'});}
}
</script>
