<template>
  <div class="setup">
    <div class="head">
      <text class="back" @click="goBack">‹</text>
      <text class="title">{{step===1 ? '选择对局模式' : '用时设置'}}</text>
    </div>

    <div class="pane" if="{{step===1}}">
      <div class="card" style="background-color:{{mode==='two'?'#0D6EFF':'#24262B'}};color:{{mode==='two'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickMode('two')">
        <text class="cardTitle">双人对弈</text>
        <text class="cardDesc">两人轮流走子</text>
      </div>
      <div class="card" style="background-color:{{mode==='ai'?'#0D6EFF':'#24262B'}};color:{{mode==='ai'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickMode('ai')">
        <text class="cardTitle">人机对战</text>
        <text class="cardDesc">与内置 AI 对弈</text>
      </div>
    </div>

    <div class="pane" if="{{step===2}}">
      <div class="row" if="{{mode==='ai'}}">
        <text class="rowLabel">我执</text>
        <div class="sideRow">
          <text class="side" style="background-color:{{mySide==='white'?'#0D6EFF':'#24262B'}};color:{{mySide==='white'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickSide('white')">白方</text>
          <text class="side" style="background-color:{{mySide==='black'?'#0D6EFF':'#24262B'}};color:{{mySide==='black'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickSide('black')">黑方</text>
        </div>
      </div>

      <div class="row">
        <text class="rowLabel">每方时长</text>
        <div class="stepper">
          <text class="stepBtn" @touchend="decMinutes">−</text>
          <text class="stepVal">{{minutesLabel}}</text>
          <text class="stepBtn" @touchend="incMinutes">+</text>
        </div>
      </div>

      <div class="row" if="{{!unlimited}}">
        <text class="rowLabel">每步加秒</text>
        <div class="stepper">
          <text class="stepBtn" @touchend="decIncrement">−</text>
          <text class="stepVal">{{incrementLabel}}</text>
          <text class="stepBtn" @touchend="incIncrement">+</text>
        </div>
      </div>

      <div class="row">
        <text class="rowLabel">棋盘大小</text>
        <div class="segRow">
          <text class="seg" style="background-color:{{boardSize==='放大'?'#0D6EFF':'#24262B'}};color:{{boardSize==='放大'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickBoard('放大')">放大</text>
          <text class="seg" style="background-color:{{boardSize==='标准'?'#0D6EFF':'#24262B'}};color:{{boardSize==='标准'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickBoard('标准')">标准</text>
          <text class="seg" style="background-color:{{boardSize==='紧凑'?'#0D6EFF':'#24262B'}};color:{{boardSize==='紧凑'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickBoard('紧凑')">紧凑</text>
        </div>
      </div>

      <div class="row" if="{{mode==='ai'}}">
        <text class="rowLabel">AI 难度</text>
        <div class="segRow">
          <text class="seg lv" style="background-color:{{aiLevel==='easy'?'#0D6EFF':'#24262B'}};color:{{aiLevel==='easy'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickLevel('easy')">简单</text>
          <text class="seg lv" style="background-color:{{aiLevel==='normal'?'#0D6EFF':'#24262B'}};color:{{aiLevel==='normal'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickLevel('normal')">普通</text>
          <text class="seg lv" style="background-color:{{aiLevel==='hard'?'#0D6EFF':'#24262B'}};color:{{aiLevel==='hard'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickLevel('hard')">困难</text>
          <text class="seg lv" style="background-color:{{aiLevel==='master'?'#0D6EFF':'#24262B'}};color:{{aiLevel==='master'?'#FFFFFF':'#C9CDD4'}};" @touchend="pickLevel('master')">大师</text>
        </div>
      </div>
    </div>

    <text class="start" if="{{step===1}}" @touchend="goStep2">下一步</text>
    <text class="start" if="{{step===2}}" @touchend="start">开始下棋</text>
  </div>
</template>
<style>
.setup { width:192dp; height:490dp; background-color:#000; padding:16dp 12dp; flex-direction:column; overflow:hidden; }
.head { width:168dp; height:40dp; flex-direction:row; align-items:center; margin-bottom:6dp; }
.back { width:32dp; height:40dp; color:#fff; font-size:30dp; line-height:40dp; text-align:center; }
.title { color:#fff; font-size:22dp; line-height:40dp; font-weight:bold; }
.pane { width:168dp; flex-direction:column; }

.card { width:168dp; height:76dp; border-radius:14dp; margin-bottom:12dp; padding:12dp; flex-direction:column; justify-content:center; }
.cardTitle { color:#fff; font-size:19dp; line-height:24dp; font-weight:bold; margin-bottom:5dp; }
.cardDesc { color:rgba(255,255,255,.72); font-size:13dp; line-height:17dp; }

.row { width:168dp; min-height:62dp; flex-direction:column; align-items:stretch; justify-content:space-between; margin-bottom:4dp; }
.rowLabel { width:100%; height:15dp; color:#fff; font-size:13dp; line-height:15dp; margin-bottom:3dp; }

.sideRow { width:168dp; flex-direction:row; justify-content:space-between; }
.side { width:81dp; height:48dp; border-radius:12dp; font-size:16dp; line-height:48dp; text-align:center; font-weight:bold; }

.stepper { width:168dp; flex-direction:row; justify-content:space-between; align-items:center; }
.stepBtn { width:52dp; height:46dp; border-radius:12dp; background-color:#2E3138; color:#fff; font-size:26dp; line-height:46dp; text-align:center; }
.stepVal { flex:1; height:46dp; line-height:46dp; margin:0 4dp; border-radius:12dp; background-color:#1C1E22; color:#fff; font-size:16dp; font-weight:bold; text-align:center; }

.segRow { width:168dp; flex-direction:row; justify-content:space-between; }
.seg { flex:1; height:44dp; margin:0 2dp; border-radius:12dp; font-size:14dp; line-height:44dp; text-align:center; }
.seg.lv { font-size:12dp; }

.start { position:absolute; left:12dp; bottom:14dp; width:168dp; height:50dp; border-radius:25dp; background-color:#0D6EFF; color:#fff; font-size:18dp; line-height:50dp; text-align:center; font-weight:bold; }
</style>
<script>
import router from '@system.router';
import storage from '@system.storage';
export default {
  data: { step:1, mode:'two', mySide:'white', aiLevel:'normal', minutes:10, increment:0, boardSize:'标准' },
  computed: {
    unlimited(){ return this.minutes === 0; },
    minutesLabel(){ return this.minutes === 0 ? '无限制' : this.minutes + ' 分钟'; },
    incrementLabel(){ return this.increment + ' 秒'; }
  },
  onInit(){ this.loadSettings(); },
  onShow(){ this.loadSettings(); },
  loadBoardSize(){
    storage.get({key:'CHESS_SETTINGS',success:(r)=>{
      try{
        const raw=r&&r.data!==undefined?r.data:r;
        const v=typeof raw==='string'?JSON.parse(raw):raw;
        this.boardSize = v&&v.boardSize ? v.boardSize : '标准';
      }catch(e){ this.boardSize='标准'; }
    },fail:()=>{ this.boardSize='标准'; }});
  },
  loadSettings(){ this.loadBoardSize(); },
  goBack(){ if(this.step===2){ this.step=1; } else { router.back(); } },
  pickMode(m){ this.mode = m; },
  pickSide(s){ this.mySide = s; },
  pickLevel(l){ this.aiLevel = l; },
  pickBoard(b){ this.boardSize = b; },
  incMinutes(){ if(this.minutes===0){ this.minutes=1; } else if(this.minutes<10){ this.minutes+=1; } else if(this.minutes<60){ this.minutes+=5; } },
  decMinutes(){ if(this.minutes<=1){ this.minutes=0; } else if(this.minutes<=10){ this.minutes-=1; } else { this.minutes-=5; } },
  incIncrement(){ if(this.increment<10){ this.increment+=1; } else if(this.increment<30){ this.increment+=5; } },
  decIncrement(){ if(this.increment<=10){ this.increment-=1; } else { this.increment-=5; } if(this.increment<0){ this.increment=0; } },
  goStep2(){ this.step=2; },
  start(){
    const unlimited = this.minutes === 0;
    const size = this.boardSize==='放大' ? '44' : (this.boardSize==='紧凑' ? '24' : '30');
    router.push({uri:'/pages/game',params:{
      minutes: String(unlimited ? 0 : this.minutes),
      increment: String(unlimited ? 0 : this.increment),
      unlimited: unlimited ? 'true' : 'false',
      boardSize: size,
      resume: 'false',
      aiMode: this.mode==='ai' ? 'true' : 'false',
      aiLevel: this.aiLevel,
      mySide: this.mode==='ai' ? this.mySide : 'white'
    }});
  }
}
</script>
