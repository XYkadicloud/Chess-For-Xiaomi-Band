<template>
  <div class="setup">
    <div class="head"><text class="back" @click="back">‹</text><text class="title">开始对局</text></div>
    <text class="label">选择每方用时</text>
    <text class="{{timeControl === '5+0' ? 'time selected' : 'time'}}" @touchend="choose('5+0')">5 分钟 · 标准</text>
    <text class="{{timeControl === '10+0' ? 'time selected' : 'time'}}" @touchend="choose('10+0')">10 分钟 · 休闲</text>
    <text class="{{timeControl === '15+0' ? 'time selected' : 'time'}}" @touchend="choose('15+0')">15 分钟 · 长局</text>
    <text class="{{timeControl === '20+0' ? 'time selected' : 'time'}}" @touchend="choose('20+0')">20 分钟 · 耐心</text>
    <text class="{{timeControl === 'unlimited' ? 'time selected' : 'time'}}" @touchend="choose('unlimited')">无限制时间</text>
    <text class="selectedText">当前：{{timeControl === 'unlimited' ? '无限制' : timeControl}}</text>
    <text class="selectedText">棋盘：{{boardSize}}</text>
        <text class="optLabel">对手</text>
    <div class="segRow">
      <text class="{{aiMode ? 'seg' : 'seg sel'}}" @touchend="setOpponent('two')">双人对弈</text>
      <text class="{{aiMode ? 'seg sel' : 'seg'}}" @touchend="setOpponent('ai')">人机对弈</text>
    </div>
    <text class="optLabel" if="{{aiMode}}">AI 难度</text>
    <div class="segRow" if="{{aiMode}}">
      <text class="{{aiLevel==='easy'?'seg lv sel':'seg lv'}}" @touchend="setLevel('easy')">简单</text>
      <text class="{{aiLevel==='normal'?'seg lv sel':'seg lv'}}" @touchend="setLevel('normal')">普通</text>
      <text class="{{aiLevel==='hard'?'seg lv sel':'seg lv'}}" @touchend="setLevel('hard')">困难</text>
      <text class="{{aiLevel==='master'?'seg lv sel':'seg lv'}}" @touchend="setLevel('master')">大师</text>
    </div>
<text class="start" @touchend="start">开始下棋</text>
  </div>
</template>
<style>
.setup { width:336dp; height:480dp; background-color:#000; padding:18dp 12dp; flex-direction:column; overflow:hidden; }
.head { width:312dp; height:38dp; flex-direction:row; align-items:center; margin-bottom:6dp; }
.back { width:32dp; color:#fff; font-size:30dp; text-align:center; }
.title { color:#fff; font-size:22dp; font-weight:bold; }
.label { color:rgba(255,255,255,.65); font-size:15dp; margin-bottom:4dp; }
.time { width:312dp; border-radius:19dp; background-color:#252828; color:#fff; text-align:center; font-size:14dp; height:30dp; line-height:30dp; margin-bottom:3dp; }
.selected { background-color:#0D6EFF; }
.selectedText { color:#4EA1FF; font-size:13dp; text-align:center; margin:7dp 0 0; }
.start { position:absolute; left:12dp; bottom:14dp; width:312dp; height:44dp; border-radius:22dp; background-color:#0D6EFF; color:#fff; font-size:18dp; line-height:44dp; text-align:center; }
.optLabel { color:rgba(255,255,255,.6); font-size:13dp; line-height:17dp; margin:4dp 0 3dp; }
.segRow { width:100%; flex-direction:row; justify-content:space-between; }
.seg { flex:1; height:30dp; margin:0 1dp; border-radius:15dp; background-color:#252828; color:#fff; font-size:13dp; line-height:30dp; text-align:center; }
.seg.sel { background-color:#0D6EFF; }
.seg.lv { font-size:11dp; }
</style>
<script>
import router from '@system.router';
import storage from '@system.storage';
export default { data:{aiMode:false,aiLevel:'normal',timeControl:'10+0',boardSize:'标准'}, onInit(){this.loadBoardSize();}, onShow(){this.loadBoardSize();}, loadBoardSize(){storage.get({key:'CHESS_SETTINGS',success:(r)=>{try{const raw=r&&r.data!==undefined?r.data:r;const v=typeof raw==='string'?JSON.parse(raw):raw;this.boardSize=v&&v.boardSize?v.boardSize:'标准';}catch(e){this.boardSize='标准';}},fail:()=>{this.boardSize='标准';}});}, back(){router.back();}, choose(v){this.timeControl=v;}, start(){const unlimited=this.timeControl==='unlimited';const minutes=unlimited?'0':(this.timeControl.split('+')[0]||'10');const size=this.boardSize==='放大'?'44':(this.boardSize==='紧凑'?'24':'30');router.push({uri:'/pages/game',params:{minutes:minutes,unlimited:unlimited?'true':'false',boardSize:size,resume:'false',aiMode:this.aiMode?'true':'false',aiLevel:this.aiLevel}});} }
</script>
