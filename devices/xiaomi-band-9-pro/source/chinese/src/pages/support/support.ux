<template>
  <div class="page">
    <div class="header">
      <text class="back" @touchend="back">‹</text>
      <text class="title">{{tt_support_title}}</text>
    </div>
    <div class="body">
      <text class="hint">{{tt_support_hint}}</text>
      <image class="qrLarge" src="/common/aifadian_qr.jpg"></image>
      <text class="caption">{{tt_support_caption}}</text>
      <text class="support">{{tt_support_body}}</text>
      <text class="backButton" @touchend="back">{{tt_support_backToAbout}}</text>
    </div>
  </div>
</template>
<style>
.page { width:336dp; height:480dp; background-color:#000000; flex-direction:column; }
.header { width:336dp; height:52dp; position:relative; align-items:center; justify-content:center; }
.back { position:absolute; left:12dp; top:8dp; width:32dp; height:36dp; color:#FFFFFF; font-size:30dp; line-height:36dp; text-align:center; }
.title { width:336dp; color:#FFFFFF; font-size:21dp; font-weight:bold; line-height:36dp; text-align:center; }
.body { width:336dp; height:428dp; align-items:center; flex-direction:column; padding-top:20dp; }
.hint { color:#4EA1FF; font-size:18dp; font-weight:bold; line-height:28dp; margin-bottom:12dp; }
.qrLarge { width:200dp; height:200dp; background-color:#FFFFFF; object-fit:contain; }
.caption { color:#FFFFFF; font-size:16dp; line-height:26dp; margin-top:12dp; }
.support { width:280dp; color:rgba(255,255,255,0.72); font-size:13dp; line-height:19dp; text-align:center; margin-top:4dp; }
.backButton { width:240dp; height:38dp; border-radius:19dp; background-color:#252828; color:#FFFFFF; font-size:15dp; line-height:38dp; text-align:center; margin-top:15dp; }
</style>
<script>
import router from '@system.router';
import configuration from '@system.configuration';
import storage from '@system.storage';
import { tr, initLang, setLang, setSystemLang, resolveLang } from '../../common/js/strings.js';
export default {
  onInit(){ this.applyLang(); },
  onShow(){ this.applyLang(); },
  data:{ langTick:0 },
  computed:{
    tt_support_title(){ this.langTick; return tr('support.title'); },
    tt_support_hint(){ this.langTick; return tr('support.hint'); },
    tt_support_caption(){ this.langTick; return tr('support.caption'); },
    tt_support_body(){ this.langTick; return tr('support.body'); },
    tt_support_backToAbout(){ this.langTick; return tr('support.backToAbout'); },
  },
  tr(k){ return tr(k); },
  applyLang(){
    let devLang = 'en';
    try{
      const loc = configuration.getLocale();
      devLang = (loc && loc.language === 'zh') ? 'zh' : 'en';
    }catch(e){ devLang = 'en'; }
    initLang({ language: devLang });
    storage.get({key:'CHESS_SETTINGS',success:(data)=>{
      try{
        const raw=data&&data.data!==undefined?data.data:data;
        const v=(raw===undefined||raw===null||raw==='')?null:(typeof raw==='string'?JSON.parse(raw):raw);
        setLang(resolveLang(v&&v.langMode, devLang));
      }catch(e){ setLang('system'); }
      this.langTick=(this.langTick||0)+1;
    },fail:()=>{ setLang('system'); this.langTick=(this.langTick||0)+1; }});
  }, back(){router.back();} }
</script>
